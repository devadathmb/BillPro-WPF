  <!-- PdfiumViewer.Native.x86_64.v8-xfa predates the RID-graph "runtimes\{rid}\native\"
       convention, so the SDK doesn't know to treat pdfium.dll as a native dependency
       and won't fold it into the single-file bundle on its own. We register it as a
       ResolvedFileToPublish BEFORE ComputeFilesToPublish runs, so IncludeNativeLibrariesForSelfExtract
       picks it up and embeds it in the single exe (self-extracted to a temp folder at
       startup, same as any other native dependency) — nothing extra to ship.
       No CopyToPublishDirectory metadata here — that flag forces a loose-file copy
       and would keep pdfium.dll sitting next to BillPro.exe instead of inside it.
       ExcludeFromSingleFile=false is the actual switch that tells the single-file
       bundler to embed this and self-extract it to %TEMP% at startup. -->
  <Target Name="AddPdfiumNativeToPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <PdfiumNativeDll Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\**\pdfium.dll" />
    </ItemGroup>
    <Error Condition="'@(PdfiumNativeDll)' == ''" Text="pdfium.dll not found under $(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa — run dotnet restore and verify the package layout." />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(PdfiumNativeDll)">
        <RelativePath>pdfium.dll</RelativePath>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Keep a plain build-time copy too, so F5/local debugging (not single-file) still
       finds pdfium.dll next to BillPro.exe in bin\x64\Debug\... -->
  <Target Name="CopyPdfiumNativeOnBuild" AfterTargets="Build">
    <ItemGroup>
      <PdfiumNativeDllBuild Include="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\**\pdfium.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfiumNativeDllBuild)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
