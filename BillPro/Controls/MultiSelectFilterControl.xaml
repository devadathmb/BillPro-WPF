<UserControl x:Class="BillPro.Controls.MultiSelectFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="toggleBtn" MinWidth="150" Padding="8,4"
                      HorizontalContentAlignment="Left"
                      Checked="ToggleBtn_Checked">
            <TextBlock x:Name="txtSelectedLabel" Text="All" TextTrimming="CharacterEllipsis"/>
        </ToggleButton>

        <Popup x:Name="popup" PlacementTarget="{Binding ElementName=toggleBtn}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               Closed="Popup_Closed">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="4" Padding="6" MinWidth="220" MaxHeight="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,0,2,6">
                        <Button x:Name="btnSelectAll" Content="All" Padding="8,2" Margin="0,0,6,0"
                                Click="BtnSelectAll_Click"/>
                        <Button x:Name="btnSelectNone" Content="None" Padding="8,2"
                                Click="BtnSelectNone_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                        <ItemsControl x:Name="itemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="2,3" Click="CheckItem_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
