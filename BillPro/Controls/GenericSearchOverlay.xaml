<UserControl x:Class="BillPro.Controls.GenericSearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             Visibility="Collapsed">

    <Grid Background="#99000000">
        <Border Width="1200" Height="700" Background="White" 
                CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#D1D5DB" BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="False">
                    <TextBlock x:Name="txtTitle" Text="Search" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" Margin="0"/>

                    <TextBox x:Name="txtSearch" Width="250" DockPanel.Dock="Right" 
             VerticalContentAlignment="Center" Padding="5,0" Margin="10,0,0,0"
             TextChanged="txtSearch_TextChanged"
             PreviewKeyDown="txtSearch_PreviewKeyDown"/>
                    <TextBlock Text="Search:" DockPanel.Dock="Right" VerticalAlignment="Center"/>

                    <StackPanel x:Name="pnlDateFilter" Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,20,0" Visibility="Collapsed">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="dpFromDate" Width="120" 
                                helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                SelectedDateChanged="DateFilter_Changed"
                                FontSize="14" FontWeight="DemiBold"/>

                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <DatePicker x:Name="dpToDate" Width="120" 
                                    helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                    SelectedDateChanged="DateFilter_Changed"
                                    FontSize="14" FontWeight="DemiBold"/>

                        <CheckBox x:Name="chkShowAll" Content="Show All" VerticalAlignment="Center" Margin="15,0,0,0" 
                                    Checked="DateFilter_Changed" Unchecked="DateFilter_Changed"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="dgItems" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          MouseDoubleClick="dgItems_MouseDoubleClick" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button x:Name="btnContinue" Content="Continue" Style="{StaticResource PrimaryOutlineButton}"  Click="btnContinue_Click"/>
                    <Button x:Name="btnClose" Content="Close" Click="btnClose_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>