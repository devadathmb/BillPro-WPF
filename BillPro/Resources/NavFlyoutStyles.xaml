<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Brushes ─────────────────────────────────────────────────────── -->
    <!-- Same navy-blue family as GlobalStyles' BrandBlue palette, just
         brightened/darkened at the edges for contrast against the dark
         sidebar (a flat BrandBlue reads muddy on near-black; these are
         tuned lighter for icons/hover and darker for the panel itself). -->
    <SolidColorBrush x:Key="NavIconBrush" Color="#4A90D9"/>
    <SolidColorBrush x:Key="NavArrowBrush" Color="#5A7C9E"/>
    <SolidColorBrush x:Key="NavFlyoutCardBrush" Color="#0E1F33"/>
    <SolidColorBrush x:Key="NavFlyoutBorderBrush" Color="#1C3A56"/>
    <SolidColorBrush x:Key="NavFlyoutHeaderBrush" Color="#C3D0DE"/>

    <!-- ── Top-level section button (MASTER FILES, ENTRIES, REPORTS...) ──── -->
    <Style x:Key="NavFlyoutTopBtn" TargetType="Button">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C3D0DE"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="14,0,10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Margin="8,2">
                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#163049"/>
                            <Setter Property="Foreground" Value="#EEF4FA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Item inside a flyout card (leaf or nested submenu launcher) ───── -->
    <Style x:Key="NavFlyoutItemBtn" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="230"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C3D0DE"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,1">
                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1A3A56"/>
                            <Setter Property="Foreground" Value="#EEF4FA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
