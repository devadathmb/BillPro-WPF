<UserControl x:Class="BillPro.Views.ProductionEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header bar -->
            <RowDefinition Height="*"/>
            <!-- consumption entry+grid -->
            <RowDefinition Height="Auto"/>
            <!-- charges / totals footer -->
            <RowDefinition Height="Auto"/>
            <!-- action buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — HEADER BAR (Production No, Date, Item Name, Produced Qty)
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Production No:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtProductionNo" Width="70" IsReadOnly="True"
                             Background="#F3F4F6" FontWeight="Bold" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Production Date:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dpProductionDate" Width="120" Margin="6,0,0,0"
                                IsEnabled="False"
                                helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=cmbFinishedGoods}"
                                helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                FontSize="14" FontWeight="DemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2" MinWidth="320">
                    <TextBlock Text="Item Name:" VerticalAlignment="Center"/>
                    <controls:SmartComboBox x:Name="cmbFinishedGoods" Width="260" Margin="6,0,0,0"
                             IsEnabled="False"
                             DisplayMemberPath="ItemName"
                             SelectedValuePath="ItemCode"
                             SelectionChanged="CmbFinishedGoods_SelectionChanged"
                             TargetOnEnter="{Binding ElementName=cmbMrp}"
                             ToolTip="Only Finished Goods and Consumables can be produced"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"  Margin="0,2,16,2">
                    <TextBlock Text="MRP / Batch:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbMrp" Width="150" Margin="6,0,0,0"
              IsEnabled="False"
              IsEditable="True"
              StaysOpenOnEdit="True"
              helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=txtProducedQty}"
              ToolTip="Pick an existing batch's MRP to add to it, or type a new MRP to start a new batch for this item">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Mrp, StringFormat=N2}" FontWeight="SemiBold" Width="60"/>
                                    <TextBlock Text="{Binding CurrentQty, StringFormat='Stock: {0:N3}'}"
                               Foreground="#6B7280" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <TextBlock Text="Produced Qty:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtProducedQty" Width="100" Margin="8,0,0,0"
                             IsEnabled="False"
                             Style="{StaticResource EntryNumericField}"
                             helpers:FocusBehavior.MoveOnEnter="True"
                             TextChanged="TxtProducedQty_TextChanged"/>
                </StackPanel>

                
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — CONSUMPTION  (entry line + grid, same shape as Purchase Entry)
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CONSUMPTION" Style="{StaticResource SectionHeader}"/>

                <!-- ── ITEM ENTRY LINE ─────────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource ItemEntryBand}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  VerticalContentAlignment="Bottom">
                        <Grid VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <!-- Code -->
                                <ColumnDefinition Width="250"/>
                                <!-- Item Name -->
                                <ColumnDefinition Width="110"/>
                                <!-- Quantity -->
                                <ColumnDefinition Width="100"/>
                                <!-- Wastage -->
                                <ColumnDefinition Width="100"/>
                                <!-- Rate -->
                                <ColumnDefinition Width="120"/>
                                <!-- Amount -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Add -->
                            </Grid.ColumnDefinitions>

                            <!-- Code -->
                            <StackPanel Grid.Column="0" Margin="0,4,7,0">
                                <TextBlock Text="Code" Style="{StaticResource EntryFieldLabel}"/>
                                <TextBox x:Name="txtEntryCode"
                                     IsEnabled="False"
                                     KeyDown="TxtEntryCode_KeyDown"
                                     LostFocus="TxtEntryCode_LostFocus"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     helpers:TextBoxBehavior.SelectAllOnFocus="True"/>
                            </StackPanel>

                            <!-- Item Name — Raw Materials + Consumables -->
                            <StackPanel Grid.Column="1" Margin="0,4,7,0">
                                <TextBlock Text="Item Name" Style="{StaticResource EntryFieldLabel}"/>
                                <controls:SmartComboBox
                                    x:Name="cmbEntryItemName"
                                    IsEnabled="False"
                                    TextSearch.TextPath="ItemName"
                                    SelectedValuePath="ItemCode"
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AllComponentItems}"
                                    SelectionChanged="CmbEntryItemName_SelectionChanged"
                                    SearchPaths="ItemName,ItemCode"
                                    helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=txtEntryQty}">
                                    <controls:SmartComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ItemCode}" FontSize="13" Margin="4,2" Foreground="#6B7280"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontSize="13" Margin="4,2" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding UnitPricePurchase, StringFormat='{}{0:N2}'}" FontSize="13" Margin="4,2" Foreground="#059669" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </controls:SmartComboBox.ItemTemplate>
                                </controls:SmartComboBox>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Column="2" Margin="0,4,7,0">
                                <TextBlock Text="Quantity" Style="{StaticResource EntryFieldLabel}" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtEntryQty"
                                     IsEnabled="False"
                                     Style="{StaticResource EntryNumericField}"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     TextChanged="EntryCalculation_TextChanged"/>
                            </StackPanel>

                            <!-- Wastage -->
                            <StackPanel Grid.Column="3" Margin="0,4,7,0">
                                <TextBlock Text="Wastage" Style="{StaticResource EntryFieldLabel}"/>
                                <TextBox x:Name="txtEntryWastage" Text="0"
                                     IsEnabled="False"
                                     Style="{StaticResource EntryNumericField}"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     TextChanged="EntryCalculation_TextChanged"/>
                            </StackPanel>

                            <!-- Rate -->
                            <StackPanel Grid.Column="4" Margin="0,4,7,0">
                                <TextBlock Text="Rate" Style="{StaticResource EntryFieldLabel}"/>
                                <TextBox x:Name="txtEntryRate"
                                     IsEnabled="False"
                                     Style="{StaticResource EntryNumericField}"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     TextChanged="EntryCalculation_TextChanged"/>
                            </StackPanel>

                            <!-- Amount (read-only preview) -->
                            <StackPanel Grid.Column="5" Margin="0,4,7,0">
                                <TextBlock Text="Amount" Style="{StaticResource EntryFieldLabel}"/>
                                <TextBox x:Name="txtEntryAmount"
                                     IsReadOnly="True" Focusable="False"
                                     Style="{StaticResource ReadOnlyField}"/>
                            </StackPanel>

                            <!-- Add button -->
                            <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,4,0,0">
                                <Button x:Name="btnAddItem"
                                    Content="＋ Add"
                                    IsEnabled="False"
                                    Click="BtnAddItem_Click"
                                    Style="{StaticResource PrimaryOutlineButton}"
                                    Width="90" Height="32" Margin="10,10,0,0"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- ── CONSUMPTION GRID ────────────────────────────────────── -->
                <syncfusion:SfDataGrid
                    x:Name="sfItems"
                    Grid.Row="2"
                    MinHeight="200"
                    RowHeight="32"
                    HeaderRowHeight="36"
                    AutoGenerateColumns="False"
                    AllowEditing="True"
                    AddNewRowPosition="None"
                    AllowDeleting="True"
                    NavigationMode="Cell"
                    SelectionMode="Single"
                    ColumnSizer="None"
                    AlternationCount="2"
                    CurrentCellEndEdit="SfItems_CurrentCellEndEdit"
                    RowValidating="SfItems_RowValidating"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="SNo" HeaderText="SNo" Width="55" AllowEditing="False"/>
                        <syncfusion:GridTextColumn MappingName="Code" HeaderText="Code" Width="90" AllowEditing="False"/>

                        <syncfusion:GridTemplateColumn MappingName="ItemName" HeaderText="Item Name"
                                                       ColumnSizer="Star" MinimumWidth="190">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}" Padding="4,0"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                            <syncfusion:GridTemplateColumn.EditTemplate>
                                <DataTemplate>
                                    <controls:SmartComboBox
                                        x:Name="cmbGridItemName"
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AllComponentItems}"
                                        TextSearch.TextPath="ItemName"
                                        SelectedValuePath="ItemCode"
                                        Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Tag="{Binding}"
                                        SelectionChanged="GridItemCombo_SelectionChanged"
                                        SearchPaths="ItemName,ItemCode"
                                        MoveOnEnter="True">
                                        <controls:SmartComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="230"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ItemCode}" FontSize="13" Margin="4,2" Foreground="#6B7280"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontSize="13" Margin="4,2" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UnitPricePurchase, StringFormat='{}{0:N2}'}" FontSize="13" Margin="4,2" Foreground="#059669" TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </controls:SmartComboBox.ItemTemplate>
                                    </controls:SmartComboBox>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.EditTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridNumericColumn MappingName="Quantity" HeaderText="Qty."     Width="90"  NumberDecimalDigits="3"/>
                        <syncfusion:GridNumericColumn MappingName="Wastage"  HeaderText="Wastage"  Width="90"  NumberDecimalDigits="3"/>
                        <syncfusion:GridNumericColumn MappingName="Rate"     HeaderText="Rate"     Width="90"  NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn MappingName="Amount"   HeaderText="Amount"   Width="110" NumberDecimalDigits="2" AllowEditing="False"/>

                        <!-- Delete row -->
                        <syncfusion:GridTemplateColumn HeaderText="" Width="45"
                            AllowEditing="False" AllowSorting="False" AllowFiltering="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GridDeleteButton}"
                                            Tag="{Binding}" Click="BtnDeleteItemRow_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — CHARGES / COST FOOTER
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: additional charges ──────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="15,10" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="Labour Charge:" VerticalAlignment="Center" Margin="0,0,6,0" Width="110"/>
                        <TextBox x:Name="txtLabourCharge" Text="0" Width="120" IsEnabled="False"
                                 Style="{StaticResource EntryNumericField}"
                                 helpers:FocusBehavior.MoveOnEnter="True"
                                 TextChanged="FooterAmount_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Other Expense:" VerticalAlignment="Center" Margin="0,0,6,0" Width="110"/>
                        <TextBox x:Name="txtOtherExpense" Text="0" Width="120" IsEnabled="False"
                                 Style="{StaticResource EntryNumericField}"
                                 helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnSave}"
                                 TextChanged="FooterAmount_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── RIGHT: totals summary ─────────────────────────────── -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16,10" Margin="4,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="90"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Total:" Margin="0,0,16,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblItemTotal" Text="0.00" TextAlignment="Right" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Average Cost:" Margin="0,0,16,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblAverageCost" Text="0.00" TextAlignment="Right" Margin="0,0,0,4"/>

                    <Separator Grid.Row="2" Grid.ColumnSpan="2" Background="#D1D5DB" Margin="0,2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Grand Total:" FontSize="18" Margin="0,0,16,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblGrandTotal" FontSize="18" FontWeight="Bold"
                               Text="0.00" TextAlignment="Right" Foreground="#059669"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 3 — ACTION BUTTONS
             ═══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,12">
            <Button x:Name="btnNew"     Content="New"    Click="BtnNew_Click"/>
            <Button x:Name="btnDisplay" Content="Display" Click="BtnDisplay_Click"/>
            <Button x:Name="btnSave"    Content="_Save"  Click="BtnSave_Click"
                    Style="{StaticResource PrimaryOutlineButton}" IsEnabled="False"/>
            <Button x:Name="btnDelete"  Content="Delete" Click="BtnDelete_Click"
                    Style="{StaticResource DangerOutlineButton}" IsEnabled="False"/>
            <Button x:Name="btnClose"   Content="Close"
                    helpers:CloseTabBehavior.CloseOnClick="True" Margin="0"/>
        </StackPanel>

        <!-- Search overlay — spans all rows -->
        <controls:GenericSearchOverlay x:Name="SearchOverlay"
                                       Grid.RowSpan="4"
                                       Panel.ZIndex="999"
                                       Visibility="Collapsed"/>
    </Grid>
</UserControl>
