<UserControl x:Class="BillPro.Views.CompanyDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             HEADER
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Company Details" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="(shown on every printed / exported invoice)" Margin="10,0,0,0"
                           Foreground="#6B7280" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             FORM
             ═══════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <!-- COMPANY IDENTITY -->
                <Border Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Identity" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,8"/>

                        <TextBlock Text="Company Name:"/>
                        <TextBox x:Name="txtCompanyName" Margin="0,2,0,8"/>

                        <TextBlock Text="Registration Number:"/>
                        <TextBox x:Name="txtRegNumber" Margin="0,2,0,8"/>

                        <TextBlock Text="Address (one line per line as it should print):"/>
                        <TextBox x:Name="txtAddress" Margin="0,2,0,0" Height="60"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- LOGO -->
                <Border Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Logo" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,8"/>
                        <TextBlock Text="Shown on the letterhead and as a faint watermark on printed/exported invoices."
                                   Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Border BorderBrush="#D1D5DB" BorderThickness="1" Width="80" Height="80"
                                    Background="White">
                                <Image x:Name="imgLogoPreview" Stretch="Uniform" Margin="4"/>
                            </Border>

                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="btnBrowseLogo" Content="Choose Logo Image..." Width="160"
                                        Padding="0,6" Margin="0,0,0,6" Click="BtnBrowseLogo_Click"/>
                                <Button x:Name="btnClearLogo" Content="Remove Logo" Width="160"
                                        Padding="0,6" Click="BtnClearLogo_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CONTACT -->
                <Border Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Contact" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Phone 1 — Label (e.g. Marketing (Nita)):"/>
                                <TextBox x:Name="txtPhone1Label" Margin="0,2,0,6"/>
                                <TextBlock Text="Phone 1 — Number:"/>
                                <TextBox x:Name="txtPhone1" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phone 2 — Label (e.g. Admin (Roni)):"/>
                                <TextBox x:Name="txtPhone2Label" Margin="0,2,0,6"/>
                                <TextBlock Text="Phone 2 — Number:"/>
                                <TextBox x:Name="txtPhone2" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email:"/>
                        <TextBox x:Name="txtEmail" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- BANK ACCOUNTS -->
                <Border Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Bank Accounts" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bank 1 — Name (e.g. BCA (Bank Central Asia)):"/>
                                <TextBox x:Name="txtBank1Name" Margin="0,2,0,6"/>
                                <TextBlock Text="Bank 1 — Account No.:"/>
                                <TextBox x:Name="txtBank1AccNo" Margin="0,2,0,6"/>
                                <TextBlock Text="Bank 1 — Account Holder:"/>
                                <TextBox x:Name="txtBank1AccHolder" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bank 2 — Name (e.g. BRI (Bank Republik Indonesia)):"/>
                                <TextBox x:Name="txtBank2Name" Margin="0,2,0,6"/>
                                <TextBlock Text="Bank 2 — Account No.:"/>
                                <TextBox x:Name="txtBank2AccNo" Margin="0,2,0,6"/>
                                <TextBlock Text="Bank 2 — Account Holder:"/>
                                <TextBox x:Name="txtBank2AccHolder" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ACTIONS -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,20">
                    <TextBlock x:Name="txtSavedFlag" Text="Saved." Foreground="#16A34A" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <Button x:Name="btnSave" Content="Save" Width="110" Padding="0,6"
                            Click="BtnSave_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
