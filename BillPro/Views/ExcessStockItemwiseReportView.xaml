<UserControl x:Class="BillPro.Views.ExcessStockItemReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <TextBlock Text="ITEM-WISE EXCESS STOCK REPORT"
                       FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <DockPanel x:Name="dockReport">
                <TextBlock DockPanel.Dock="Bottom" Text="Tip: click the + on a row to expand an item's individual adjustment lines. Double-click or right-click a line inside the expanded list for full details / edit"
                       FontSize="10.5" Foreground="#9CA3AF" Margin="10,3" HorizontalAlignment="Left"/>

                <!-- Outer grid: one row per item, additive totals only. No
                     MouseDoubleClick/ContextMenu here — same reason as
                     SalesReturnItemReportView: editing only makes sense on
                     the nested detail grid, wired at the DockPanel level
                     below. -->
                <syncfusion:SfDataGrid
                x:Name="sfReport"
                RowHeight="32"
                HeaderRowHeight="36"
                AutoGenerateColumns="False"
                AllowEditing="False"
                AllowSorting="True"
                AllowFiltering="False"
                AddNewRowPosition="None"
                NavigationMode="Row"
                SelectionMode="Single"
                ColumnSizer="None"
                AlternationCount="2"
                BorderThickness="0"
                ShowRowHeader="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn     MappingName="ItemCode"          HeaderText="Item Code"       Width="100"/>
                        <syncfusion:GridTextColumn     MappingName="ItemName"          HeaderText="Item Name"       ColumnSizer="Star" MinimumWidth="200"/>
                        <syncfusion:GridTextColumn     MappingName="HsnCode"           HeaderText="HSN"             Width="90"/>
                        <syncfusion:GridNumericColumn  MappingName="TotalQty"          HeaderText="Total Qty"       Width="100" NumberDecimalDigits="3"/>
                        <syncfusion:GridNumericColumn  MappingName="TotalPurchaseRate" HeaderText="Total Purch. Rate" Width="120" NumberDecimalDigits="2"/>
                    </syncfusion:SfDataGrid.Columns>

                    <syncfusion:SfDataGrid.DetailsViewDefinition>
                        <syncfusion:GridViewDefinition RelationalColumn="Details">
                            <syncfusion:GridViewDefinition.DataGrid>
                                <!-- No MouseDoubleClick/ContextMenu here — attached in
                                     code-behind at the DockPanel level instead. -->
                                <syncfusion:SfDataGrid
                                    RowHeight="30"
                                    HeaderRowHeight="32"
                                    AutoGenerateColumns="False"
                                    AllowEditing="False"
                                    AllowSorting="True"
                                    AllowFiltering="False"
                                    AddNewRowPosition="None"
                                    NavigationMode="Row"
                                    SelectionMode="Single"
                                    ColumnSizer="None"
                                    AlternationCount="2"
                                    BorderThickness="0"
                                    ShowRowHeader="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                                    <syncfusion:SfDataGrid.RowStyle>
                                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                        </Style>
                                    </syncfusion:SfDataGrid.RowStyle>

                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridDateTimeColumn MappingName="EntryDate"        HeaderText="Entry Date" Width="95"  Pattern="ShortDate"/>
                                        <syncfusion:GridTextColumn     MappingName="FormattedEntryNo" HeaderText="Entry No"   Width="90"/>
                                        <syncfusion:GridTextColumn     MappingName="ItemCode"         HeaderText="Item Code"  Width="90"/>
                                        <syncfusion:GridTextColumn     MappingName="ItemName"         HeaderText="Item Name"  ColumnSizer="Star" MinimumWidth="150"/>
                                        <syncfusion:GridTextColumn     MappingName="BatchNumber"      HeaderText="Batch"      Width="90"/>
                                        <syncfusion:GridNumericColumn  MappingName="Mrp"              HeaderText="MRP"        Width="80"  NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="PurchaseRate"     HeaderText="Purch. Rate" Width="90" NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="Qty"              HeaderText="Qty"        Width="80"  NumberDecimalDigits="3"/>
                                        <syncfusion:GridTextColumn     MappingName="Remarks"          HeaderText="Remarks"    Width="140"/>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>
                            </syncfusion:GridViewDefinition.DataGrid>
                        </syncfusion:GridViewDefinition>
                    </syncfusion:SfDataGrid.DetailsViewDefinition>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0"
                BorderBrush="#111827" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnExpandAll"   Content="Expand All"   Click="BtnExpandAll_Click"   MinWidth="90" Margin="0,0,6,0"/>
                    <Button x:Name="btnCollapseAll" Content="Collapse All" Click="BtnCollapseAll_Click" MinWidth="90"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Text="Total Qty" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblTotalQty" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Total Purch. Rate" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblGrandTotal" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0" MaxHeight="240">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="From:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFromDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="To:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpToDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                            <TextBlock Text="Search:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSearch" Width="180" Margin="6,0,0,0"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     helpers:TextBoxBehavior.SelectAllOnFocus="True"
                                     ToolTip="Item name, Item code, Remarks, or Entry No"
                                     KeyDown="TxtSearch_KeyDown"/>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click"
                            Style="{StaticResource PrimaryOutlineButton}" MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPrint"   Content="Print" Click="BtnPrint_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPdf"     Content="PDF"   Click="BtnPdf_Click"     MinWidth="80" Margin="4"/>
                    <Button x:Name="btnExcel"   Content="Excel" Click="BtnExcel_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnClose"   Content="Close" MinWidth="80" Margin="4"
                            helpers:CloseTabBehavior.CloseOnClick="True"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
