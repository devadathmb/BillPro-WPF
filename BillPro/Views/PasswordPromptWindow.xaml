<Window x:Class="BillPro.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:BillPro.Helpers"
        Title="Company Details — Unlock"
        Height="160" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#E9ECEF">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter password to edit Company Details" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <PasswordBox x:Name="pwdBox" Grid.Row="1" Padding="6,4" KeyDown="PwdBox_KeyDown"
                     helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnOk}"/>

        <TextBlock x:Name="txtError" Grid.Row="2" Text="Incorrect password." Foreground="#DC2626"
                   Visibility="Collapsed" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="Unlock" Width="80"  Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
