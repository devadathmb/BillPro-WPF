<Window x:Class="BillPro.Views.BillRangePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select a Bill"
        Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#E9ECEF">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblTitle" Text="SELECT A BILL"
                   FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" x:Name="lblSubTitle"
                   FontSize="11" Foreground="#6B7280" Margin="0,0,0,10"
                   Text="This line summarizes more than one bill. Double-click one to edit it."/>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
            <DataGrid x:Name="gridBills" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal" BorderThickness="0" SelectionMode="Single"
                      MouseDoubleClick="GridBills_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bill/Entry No" Binding="{Binding FormattedNo}"   Width="120"/>
                    <DataGridTextColumn Header="Date"          Binding="{Binding DateLabel}"      Width="90"/>
                    <DataGridTextColumn Header="Party"         Binding="{Binding PartyName}"      Width="*"/>
                    <DataGridTextColumn Header="Amount"        Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnClose" Content="Close" MinWidth="90" Padding="10,6" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
