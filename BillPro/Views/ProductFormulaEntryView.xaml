<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d" x:Class="BillPro.Views.ProductFormulaEntryView">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Finished good / consumable picker -->
            <RowDefinition Height="Auto"/>
            <!-- divider -->
            <RowDefinition Height="Auto"/>
            <!-- entry line -->
            <RowDefinition Height="*"/>
            <!-- grid -->
            <RowDefinition Height="Auto"/>
            <!-- divider -->
            <RowDefinition Height="Auto"/>
            <!-- action buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ITEM THE FORMULA IS FOR — Finished Goods + Consumables only
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Item Name" VerticalAlignment="Center" FontSize="14" FontWeight="DemiBold"/>
            <controls:SmartComboBox x:Name="cmbFinishedGoods" Grid.Column="1" 
                      DisplayMemberPath="ItemName" 
                      SelectedValuePath="ItemCode"
                      SelectionChanged="CmbFinishedGoods_SelectionChanged"
                      IsTextSearchEnabled="False"
                      MoveOnEnter="True"
                      SearchPaths="ItemName,ItemCode"
                      ToolTip="Only Finished Goods and Consumables can have a formula defined"/>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#E5E7EB" Margin="0,0,0,0"/>

        <!-- ═══════════════════════════════════════════════════════════
             ENTRY LINE — pick a component, enter Qty, Add to grid below
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource ItemEntryBand}" Margin="0,10,0,10">
            <Grid VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="260"/>
                    <!-- Item Name -->
                    <ColumnDefinition Width="150"/>
                    <!-- Quantity -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Add button -->
                </Grid.ColumnDefinitions>

                <!-- Component item — SmartComboBox, Raw Materials + Consumables only -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Component (Raw Material / Consumable)" Style="{StaticResource EntryFieldLabel}"/>
                    <controls:SmartComboBox
                        x:Name="cmbEntryItemName"
                        IsEnabled="False"
                        TextSearch.TextPath="ItemName"
                        SelectedValuePath="ItemCode"
                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AllRawMaterials}"
                        SelectionChanged="CmbEntryItemName_SelectionChanged"
                        SearchPaths="ItemName,ItemCode"
                        helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=txtEntryQty}"
                        helpers:FocusBehavior.TargetOnTab="{Binding ElementName=btnSave}">
                        <controls:SmartComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ItemCode}" FontSize="13" Margin="4,2" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontSize="13" Margin="4,2" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UnitPricePurchase, StringFormat='{}{0:N2}'}" FontSize="13" Margin="4,2" Foreground="#059669" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </controls:SmartComboBox.ItemTemplate>
                    </controls:SmartComboBox>
                </StackPanel>

                <!-- Quantity -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Quantity" Style="{StaticResource EntryFieldLabel}" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtEntryQty"
                             IsEnabled="False"
                             Style="{StaticResource EntryNumericField}"
                             helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnAddLine}"/>
                </StackPanel>

                <!-- Add button -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="btnAddLine"
                            Content="＋ Add"
                            IsEnabled="False"
                            Click="BtnAddLine_Click"
                            Style="{StaticResource PrimaryOutlineButton}"
                            Width="90" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             GRID — added lines only. Editable for corrections; no direct
             row-adding here (mirrors Purchase Entry's line-then-grid flow).
             ═══════════════════════════════════════════════════════════ -->
        <syncfusion:SfDataGrid
            x:Name="dgFormula"
            Grid.Row="3"
            AutoGenerateColumns="False"
            AllowEditing="True"
            AddNewRowPosition="None"
            AllowDeleting="True"
            NavigationMode="Cell"
            SelectionMode="Single"
            ColumnSizer="None"
            AlternationCount="2"
            RowHeight="30"
            HeaderRowHeight="32"
            BorderThickness="1"
            BorderBrush="#E5E7EB"
            Background="#FFFFFF"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            CurrentCellEndEdit="DgFormula_CurrentCellEndEdit"
            RowValidating="DgFormula_RowValidating">

            <syncfusion:SfDataGrid.RowStyle>
                <Style TargetType="syncfusion:VirtualizingCellsControl">
                    <Setter Property="Background" Value="White"/>
                </Style>
            </syncfusion:SfDataGrid.RowStyle>

            <syncfusion:SfDataGrid.AlternatingRowStyle>
                <Style TargetType="syncfusion:VirtualizingCellsControl">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Style>
            </syncfusion:SfDataGrid.AlternatingRowStyle>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="SNo" HeaderText="SNo" Width="50" AllowEditing="False"/>

                <syncfusion:GridTextColumn MappingName="Code" HeaderText="Code" Width="130" AllowEditing="False"/>

                <!-- Item Name — re-editable via SmartComboBox if a correction is needed -->
                <syncfusion:GridTemplateColumn MappingName="ItemName" HeaderText="Item Name"
                                               ColumnSizer="Star" MinimumWidth="220">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ItemName}" Padding="8,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                    <syncfusion:GridTemplateColumn.EditTemplate>
                        <DataTemplate>
                            <controls:SmartComboBox
                                x:Name="cmbGridItemName"
                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AllRawMaterials}"
                                TextSearch.TextPath="ItemName"
                                SelectedValuePath="ItemCode"
                                Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Tag="{Binding}"
                                SelectionChanged="GridItemName_SelectionChanged"
                                SearchPaths="ItemName,ItemCode"
                                MoveOnEnter="True">
                                <controls:SmartComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="230"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ItemCode}" FontSize="13" Margin="4,2" Foreground="#6B7280"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ItemName}" FontSize="13" Margin="4,2" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UnitPricePurchase, StringFormat='{}{0:N2}'}" FontSize="13" Margin="4,2" Foreground="#059669" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </controls:SmartComboBox.ItemTemplate>
                            </controls:SmartComboBox>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.EditTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridNumericColumn MappingName="Quantity" HeaderText="Qty." Width="110" NumberDecimalDigits="2"/>

                <!-- Delete row -->
                <syncfusion:GridTemplateColumn HeaderText="" Width="40"
                    AllowEditing="False" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="BtnDeleteRow_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Cursor="Hand"
                                    ToolTip="Delete this row"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="16" Height="16">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial">

                                            <Setter Property="Foreground" Value="#EF4444"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>

                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Border Grid.Row="4" Height="1" Background="#E5E7EB" Margin="0,12,0,12"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Save" Style="{StaticResource PrimaryOutlineButton}" IsEnabled="False" Click="BtnSave_Click"/>
            <Button x:Name="btnNext"  Content="Next"  Click="BtnNext_Click"/>
            <Button x:Name="btnClose" Content="Close" Margin="0" helpers:CloseTabBehavior.CloseOnClick="True"/>
        </StackPanel>
    </Grid>
</UserControl>
