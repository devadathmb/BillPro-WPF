<UserControl x:Class="BillPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5FA">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <!-- Glass look: translucent gradient tint over the true per-card
                 blurred backdrop (imgLogoBlurred, clipped to this card's
                 bounds in code-behind), plus a faint white edge for the
                 "frosted panel" read. Lighter than a flat white now because
                 the blur underneath is doing the real work — this is just
                 the tint + sheen on top of it. -->
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B3FFFFFF" Offset="0"/>
                        <GradientStop Color="#80FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#73FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B0B4C8" Opacity="0.22" BlurRadius="16" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8890A8"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="QuickActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandBlueLight}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlueDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrandBlueSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickActionIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="QuickActionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- Dashboard background logo — fills the entire page and resizes
             dynamically with the window/control (no fixed Width/Height, so
             it scales with whatever space the Grid has). Non-interactive so
             it never intercepts clicks/scroll. Sits in the outer Grid (not
             inside the ScrollViewer's content) so it stays fixed in the
             viewport instead of scrolling away with the KPI cards/charts.
             This is a separate, dedicated dashboard logo (not the invoice
             letterhead logo from CompanyRepository) — see LoadWatermarkLogo
             in code-behind for where the file is expected on disk.
             Stretch="UniformToFill" always covers edge-to-edge regardless of
             the logo's own aspect ratio (WPF clips an Image's rendered
             content to its own layout bounds automatically, so no manual
             clip geometry is needed).

             TRUE per-card glass (not a globally blurred image): this sharp
             copy is the base layer, fully visible in the gaps between
             cards. A second copy (imgLogoBlurred, right below) sits on top
             of this one with a BlurEffect, but its Clip is set in
             code-behind (see UpdateGlassCardMask) to the exact rounded
             rectangle of every card, recomputed live as the page resizes or
             scrolls. So the blurred copy only ever paints in the regions
             cards actually cover — everywhere else it's clipped away,
             letting this sharp layer show straight through. That's what
             gives the "blur only what's behind the glass" effect WPF has no
             built-in backdrop-filter for. -->
        <Image x:Name="imgLogoWatermark"
               Stretch="UniformToFill"
               Opacity="0.05"
               HorizontalAlignment="Stretch" VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="0"/>

        <!-- Blurred twin of imgLogoWatermark — same source bitmap, set in
             code-behind. Only ever visible inside the Clip geometry that
             UpdateGlassCardMask rebuilds from the current on-screen bounds
             of every CardStyle Border, so it reads as "this card's patch of
             logo, blurred" rather than a second full-page image. -->
        <Image x:Name="imgLogoBlurred"
               Stretch="UniformToFill"
               Opacity="0.07"
               HorizontalAlignment="Stretch" VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="1">
            <Image.Effect>
                <BlurEffect Radius="18" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Panel.ZIndex="2">
            <StackPanel Margin="26,22,26,26">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtGreeting" Text="Welcome back" FontSize="22" FontWeight="Black" Foreground="#1A1A2E" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtToday" Text="Today" FontSize="13" Foreground="#8890A8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="btnRefresh" Click="BtnRefresh_Click"
                        Background="White" Foreground="#4C58AD" BorderBrush="#D8DCF4" BorderThickness="1"
                        Padding="1" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" FontSize="15" Margin="0,0,5,2" VerticalAlignment="Center" Padding="0"/>
                            <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- KPI cards -->
                <UniformGrid Rows="1" Columns="5" Margin="0,0,0,20">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="🧾" FontSize="18"/>
                            <TextBlock x:Name="txtBillCount" Text="0" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="Bills Today" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="💰" FontSize="18"/>
                            <TextBlock x:Name="txtSalesAmount" Text="₹0" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="Sales Today" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="📈" FontSize="18"/>
                            <TextBlock x:Name="txtProfit" Text="₹0" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="Profit Today" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="📦" FontSize="18"/>
                            <TextBlock x:Name="txtItemsSold" Text="0" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="Items Sold" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="🏦" FontSize="18"/>
                            <TextBlock x:Name="txtCashInHand" Text="₹0" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="Cash in Hand" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Chart + side panels + Recent Bills + Quick Actions, all sharing
                 one set of column definitions so the two rows line up exactly:
                 col0/1/2 = Chart+gap+Top Items width (Recent Bills spans all three
                 below it); col3 = gap; col4 = Low Stock width (Quick Actions
                 matches it exactly below). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Sales chart | Top Items Today | Low Stock Alerts -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Sales — Last 7 Days" Style="{StaticResource SectionTitle}"/>
                            <!-- Populated in code-behind: one column per day, bar + amount + day label -->
                            <Grid x:Name="ChartGrid" Height="200"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Top Items Today" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl x:Name="TopItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ItemName}" FontSize="12.5" Foreground="#1A1A2E" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Qty}" FontSize="12.5" FontWeight="Bold" Foreground="#4C58AD" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="txtNoTopItems" Text="No sales yet today." FontSize="12" Foreground="#B0B4C8" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Low Stock Alerts" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl x:Name="LowStockList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ItemName}" FontSize="12.5" Foreground="#1A1A2E" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentQty}" FontSize="12.5" FontWeight="Bold" Foreground="#D9534F" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="txtNoLowStock" Text="Nothing low on stock. 👍" FontSize="12" Foreground="#B0B4C8" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Recent Bills spans Chart+gap+Top Items (cols 0-2) so
                     its right edge lines up with the end of Top Items Today;
                     Quick Actions occupies only col 4, matching Low Stock's width. -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Recent Bills" Style="{StaticResource SectionTitle}"/>

                            <ListBox Grid.Row="1" x:Name="RecentBillsList" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 MouseDoubleClick="RecentBillsList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="RowBorder" Padding="8,1" CornerRadius="8"
                                        Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="16"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#EAF0FC"/>
                                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#C7D6F5"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#D7E3FA"/>
                                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#A9C2F0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedBillNo}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource NavArrowBrush}" Width="90" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="12.5" Foreground="#1A1A2E" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding NetTotal, StringFormat={}₹{0:N0}}" FontSize="12.5" Foreground="#1A1A2E" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="1" x:Name="txtNoRecentBills" Text="No bills yet." FontSize="12" Foreground="#B0B4C8" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Quick Actions" Style="{StaticResource SectionTitle}"/>

                            <UniformGrid Grid.Row="1" Columns="3" Rows="2">
                                <Button Style="{StaticResource QuickActionBtn}" Click="BtnNewSale_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🧾" Style="{StaticResource QuickActionIcon}"/>
                                        <TextBlock Text="Sales Entry" Style="{StaticResource QuickActionLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionBtn}" Click="BtnNewPurchase_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛒" Style="{StaticResource QuickActionIcon}"/>
                                        <TextBlock Text="Purchase Entry" Style="{StaticResource QuickActionLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionBtn}" Click="BtnReceipt_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="💵" Style="{StaticResource QuickActionIcon}"/>
                                        <TextBlock Text="Receipt Entry" Style="{StaticResource QuickActionLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionBtn}" Click="BtnPayment_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="💳" Style="{StaticResource QuickActionIcon}"/>
                                        <TextBlock Text="Payment Entry" Style="{StaticResource QuickActionLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionBtn}" Click="BtnStockReport_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📊" Style="{StaticResource QuickActionIcon}"/>
                                        <TextBlock Text="Current Stock" Style="{StaticResource QuickActionLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionBtn}" Click="BtnDaybook_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📘" Style="{StaticResource QuickActionIcon}"/>
                                        <TextBlock Text="Day Book" Style="{StaticResource QuickActionLabel}"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
