<UserControl x:Class="BillPro.Views.PurchaseItemReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <TextBlock Text="ITEM-WISE PURCHASE REPORT"
                       FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <DockPanel x:Name="dockReport">
                <TextBlock DockPanel.Dock="Bottom" Text="Tip: click the + on a row to expand an item's individual purchase lines. Double-click or right-click a line inside the expanded list for full bill details / edit"
                       FontSize="10.5" Foreground="#9CA3AF" Margin="10,3" HorizontalAlignment="Left"/>

                <!-- OUTER GRID — one row per item (summary totals only).
                     No MouseDoubleClick/ContextMenu here on purpose: summary
                     rows aren't tied to a single bill, so "Edit"/"View
                     Details" only make sense — and are only wired up — on
                     the nested detail grid below. -->
                <syncfusion:SfDataGrid
                x:Name="sfReport"
                RowHeight="32"
                HeaderRowHeight="36"
                AutoGenerateColumns="False"
                AllowEditing="False"
                AllowSorting="True"
                AllowFiltering="False"
                AddNewRowPosition="None"
                NavigationMode="Row"
                SelectionMode="Single"
                ColumnSizer="None"
                AlternationCount="2"
                BorderThickness="0"
                ShowRowHeader="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn     MappingName="ItemCode"        HeaderText="Item Code"     Width="100"/>
                        <syncfusion:GridTextColumn     MappingName="ItemName"        HeaderText="Item Name"     ColumnSizer="Star" MinimumWidth="200"/>
                        <syncfusion:GridTextColumn     MappingName="HsnCode"         HeaderText="HSN"           Width="90"/>
                        <syncfusion:GridNumericColumn  MappingName="TotalQuantity"   HeaderText="Total Qty"     Width="100" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn  MappingName="TotalDiscount"   HeaderText="Total Discount" Width="110" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn  MappingName="TotalTaxAmount"  HeaderText="Total Tax Amt" Width="110" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn  MappingName="TotalPrice"      HeaderText="Total Price"   Width="120" NumberDecimalDigits="2"/>
                    </syncfusion:SfDataGrid.Columns>

                    <!-- MASTER-DETAILS VIEW — expanding a summary row shows
                         its full set of individual purchase lines, with
                         every original column (including per-line Rate/MRP,
                         which can't be shown at the summary level). This is
                         where the existing bill-drilldown pattern lives now. -->
                    <syncfusion:SfDataGrid.DetailsViewDefinition>
                        <syncfusion:GridViewDefinition RelationalColumn="Details">
                            <syncfusion:GridViewDefinition.DataGrid>
                                <!-- NOTE: no MouseDoubleClick/ContextMenu set here in XAML.
                                     Syncfusion creates a brand-new SfDataGrid instance per
                                     expanded row by cloning this definition, and compiled
                                     event-handler wiring does NOT survive that clone (only
                                     properties like Columns do). Both are attached in
                                     code-behind instead, via SfReport_DetailsViewExpanded. -->
                                <syncfusion:SfDataGrid
                                    RowHeight="30"
                                    HeaderRowHeight="32"
                                    AutoGenerateColumns="False"
                                    AllowEditing="False"
                                    AllowSorting="True"
                                    AllowFiltering="False"
                                    AddNewRowPosition="None"
                                    NavigationMode="Row"
                                    SelectionMode="Single"
                                    ColumnSizer="None"
                                    AlternationCount="2"
                                    BorderThickness="0"
                                    ShowRowHeader="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                                    <syncfusion:SfDataGrid.RowStyle>
                                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                        </Style>
                                    </syncfusion:SfDataGrid.RowStyle>

                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridDateTimeColumn MappingName="PurchaseDate" HeaderText="Pur Date"    Width="95"  Pattern="ShortDate"/>
                                        <syncfusion:GridTextColumn     MappingName="BillNo"       HeaderText="Bill No"      Width="110"/>
                                        <syncfusion:GridTextColumn     MappingName="VendorName"   HeaderText="Supplier"     ColumnSizer="Star" MinimumWidth="150"/>
                                        <syncfusion:GridTextColumn     MappingName="ItemCode"     HeaderText="Item Code"    Width="90"/>
                                        <syncfusion:GridTextColumn     MappingName="ItemName"     HeaderText="Item Name"    ColumnSizer="Star" MinimumWidth="160"/>
                                        <syncfusion:GridTextColumn     MappingName="HsnCode"      HeaderText="HSN"          Width="80"/>
                                        <syncfusion:GridNumericColumn  MappingName="Mrp"          HeaderText="MRP"          Width="80"  NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="Rate"         HeaderText="Rate"         Width="80"  NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="Quantity"     HeaderText="Qty"          Width="70"  NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="Discount"     HeaderText="Discount"     Width="85"  NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="TaxRate"      HeaderText="Tax %"        Width="65"  NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="TaxAmount"    HeaderText="Tax Amt"      Width="90"  NumberDecimalDigits="2"/>
                                        <syncfusion:GridNumericColumn  MappingName="Price"        HeaderText="Price"        Width="100" NumberDecimalDigits="2"/>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>
                            </syncfusion:GridViewDefinition.DataGrid>
                        </syncfusion:GridViewDefinition>
                    </syncfusion:SfDataGrid.DetailsViewDefinition>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0"
                BorderBrush="#111827" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnExpandAll"   Content="Expand All"   Click="BtnExpandAll_Click"   MinWidth="90" Margin="0,0,6,0"/>
                    <Button x:Name="btnCollapseAll" Content="Collapse All" Click="BtnCollapseAll_Click" MinWidth="90"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Text="Qty" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblTotalQty" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,24,0">
                    <TextBlock Text="Tax Amt" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblTotalTax" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Total Price" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblGrandTotal" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0" MaxHeight="240">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="From:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFromDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="To:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpToDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                            <TextBlock Text="Search:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtVendorSearch" Width="180" Margin="6,0,0,0"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     helpers:TextBoxBehavior.SelectAllOnFocus="True"
                                     ToolTip="Item name, Item code, Supplier name, or Bill No"
                                     KeyDown="TxtVendorSearch_KeyDown"/>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click"
                            Style="{StaticResource PrimaryOutlineButton}" MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPrint"   Content="Print" Click="BtnPrint_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPdf"     Content="PDF"   Click="BtnPdf_Click"     MinWidth="80" Margin="4"/>
                    <Button x:Name="btnExcel"   Content="Excel" Click="BtnExcel_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnClose"   Content="Close" MinWidth="80" Margin="4"
                            helpers:CloseTabBehavior.CloseOnClick="True"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
