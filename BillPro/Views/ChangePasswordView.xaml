<UserControl x:Class="BillPro.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             Background="#E9ECEF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="White" Padding="24,20" Margin="15,0,15,0"
                CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1"
                HorizontalAlignment="Stretch" MaxWidth="520">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource SectionHeader}"
                           Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" Margin="0,8,0,10"/>

                <TextBlock Text="Username" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="txtUsername" Grid.Row="1" Grid.Column="1" Margin="0,8,0,8"
                         helpers:FocusBehavior.MoveOnEnter="True"/>

                <TextBlock Text="Current Password" Grid.Row="2" Grid.Column="0"/>
                <PasswordBox x:Name="pwdCurrent" Grid.Row="2" Grid.Column="1"
                             Height="26" FontSize="14" Margin="0,8,0,8"
                             helpers:FocusBehavior.MoveOnEnter="True"/>

                <TextBlock Text="New Password" Grid.Row="3" Grid.Column="0"/>
                <PasswordBox x:Name="pwdNew" Grid.Row="3" Grid.Column="1"
                             Height="26" FontSize="14" Margin="0,8,0,8"
                             helpers:FocusBehavior.MoveOnEnter="True"/>

                <TextBlock Text="Re-enter New Password" Grid.Row="4" Grid.Column="0"/>
                <PasswordBox x:Name="pwdConfirm" Grid.Row="4" Grid.Column="1"
                             Height="26" FontSize="14" Margin="0,8,0,0"
                             helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnChange}"/>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnChange" Content="Change Password" Width="160"
                            Click="BtnChange_Click" Style="{StaticResource PrimaryOutlineButton}"/>
                </StackPanel>

                <TextBlock x:Name="txtError" Grid.Row="7" Grid.ColumnSpan="2"
                           Foreground="#DC2626" Margin="0,10,0,0"
                           Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="txtSuccess" Grid.Row="7" Grid.ColumnSpan="2"
                           Foreground="#059669" Margin="0,10,0,0"
                           Visibility="Collapsed" TextAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
