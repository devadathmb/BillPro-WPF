<UserControl x:Class="BillPro.Views.SalesSeriesConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="White" Padding="20" Margin="15,0,15,0"
                CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1"
                HorizontalAlignment="Center" MaxWidth="1200">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="SALES NUMBER SERIES" Style="{StaticResource SectionHeader}" Margin="0,0,0,15"/>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,4,16,4">
                            <TextBlock Text="Prefix" Style="{StaticResource EntryFieldLabel}"/>
                            <TextBox x:Name="txtPrefix" Width="90"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     helpers:TextBoxBehavior.SelectAllOnFocus="True"
                                     IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,16,4">
                            <TextBlock Text="Start Number" Style="{StaticResource EntryFieldLabel}"/>
                            <TextBox x:Name="txtStartNumber" Width="90"
                                     Style="{StaticResource EntryNumericField}"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,16,4">
                            <TextBlock Text="Customer Type" Style="{StaticResource EntryFieldLabel}"/>
                            <ComboBox x:Name="cmbCustomerType" Width="100" helpers:FocusBehavior.MoveOnEnter="True" IsEnabled="False">
                                <ComboBoxItem Content="B2B" IsSelected="True"/>
                                <ComboBoxItem Content="B2C"/>
                                
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,4,16,4">
                            <TextBlock Text="Transaction Type" Style="{StaticResource EntryFieldLabel}"/>
                            <ComboBox x:Name="cmbTransactionType" Width="120" helpers:FocusBehavior.MoveOnEnter="True" IsEnabled="False" >
                                <ComboBoxItem Content="Local"/>
                                <ComboBoxItem Content="Interstate"/>
                                <ComboBoxItem Content="Export"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,4,16,4">
                            <TextBlock Text="Suffix Type" Style="{StaticResource EntryFieldLabel}"/>
                            <ComboBox x:Name="cmbSuffixType" Width="130" SelectionChanged="CmbSuffixType_SelectionChanged" helpers:FocusBehavior.MoveOnEnter="True" IsEnabled="False">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="FinancialYear"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="pnlFySuffixFormat" Margin="0,4,16,4" Visibility="Collapsed">
                            <TextBlock Text="FY Format" Style="{StaticResource EntryFieldLabel}"/>
                            <ComboBox x:Name="cmbFySuffixFormat" Width="120" SelectionChanged="CmbSuffixType_SelectionChanged" helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnSaveSeries}" IsEnabled="False">
                                <ComboBoxItem Content="YY-YY" IsSelected="True"/>
                                <ComboBoxItem Content="YYYY-YY"/>
                                <ComboBoxItem Content="YYYY-YYYY"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="pnlCustomSuffix" Margin="0,4,16,4" Visibility="Collapsed">
                            <TextBlock Text="Custom Suffix" Style="{StaticResource EntryFieldLabel}"/>
                            <TextBox x:Name="txtCustomSuffix" Width="130"
                                     helpers:FocusBehavior.MoveOnEnter="True"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,16,4">
                            <TextBlock Text="Active" Style="{StaticResource EntryFieldLabel}"/>
                            <CheckBox x:Name="chkIsActive" IsChecked="True" VerticalAlignment="Center" Margin="2,6,0,0"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="0,4,0,4">
                            <Button x:Name="btnSaveSeries" Content="_Save Series" Click="BtnSaveSeries_Click"
                                    Style="{StaticResource PrimaryOutlineButton}" Width="110" Height="32"/>
                        </StackPanel>

                    </WrapPanel>

                    <TextBlock x:Name="lblPreview" Margin="0,10,0,10" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                </StackPanel>

                <syncfusion:SfDataGrid
                    x:Name="sfSeries"
                    Grid.Row="1"
                    Height="250"
                    Margin="0,10,0,0"
                    RowHeight="32"
                    HeaderRowHeight="36"
                    AutoGenerateColumns="False"
                    AllowEditing="False"
                    AllowSorting="True"
                    AddNewRowPosition="None"
                    NavigationMode="Row"
                    SelectionMode="Single"
                    SelectionChanged="SfSeries_SelectionChanged"
                    ColumnSizer="None"
                    AlternationCount="2"
                    BorderThickness="1"
                    BorderBrush="#E5E7EB"
                    ShowRowHeader="False">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="Prefix"           HeaderText="Prefix"           Width="80"/>
                        <syncfusion:GridTextColumn MappingName="StartNumber"      HeaderText="Start No."        Width="90"/>
                        <syncfusion:GridTextColumn MappingName="CurrentNumber"    HeaderText="Last Bill No."      Width="100"/>
                        <syncfusion:GridTextColumn MappingName="CustomerType"     HeaderText="Customer Type"    Width="130"/>
                        <syncfusion:GridTextColumn MappingName="TransactionType"  HeaderText="Transaction Type" Width="130"/>
                        <syncfusion:GridTextColumn MappingName="SuffixType"       HeaderText="Suffix Type"      Width="110"/>
                        <syncfusion:GridTextColumn MappingName="SuffixValue"      HeaderText="Suffix Value"     Width="110"/>
                        <syncfusion:GridTextColumn MappingName="IsActive"         HeaderText="Active"           Width="70"/>

                        <!-- Default series — radio behaviour: picking one clears every
                             other row's flag (see RadioDefault_Checked in code-behind).
                             This is the series Sales Entry pre-selects on a new bill. -->
                        <syncfusion:GridTemplateColumn HeaderText="Default" Width="70"
                            AllowEditing="False" AllowSorting="False" AllowFiltering="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="DefaultSeries"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsChecked="{Binding IsDefaultChecked, Mode=OneWay}"
                                                 Tag="{Binding}"
                                                 Click="RadioDefault_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="btnNewSeries" Content="New" Click="BtnNewSeries_Click"  Width="90" Height="32"/>
                    <Button x:Name="btnClose" Content="Close" helpers:CloseTabBehavior.CloseOnClick="True" Margin="0" Width="100"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>