<UserControl x:Class="BillPro.Views.JournalEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════ HEADER ═══════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="JOURNAL ENTRY" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"
                           VerticalAlignment="Center" Margin="0,0,30,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Voucher No:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtEntryNo" Width="80" Margin="6,0,0,0"
                             IsReadOnly="True" Focusable="False"
                             Style="{StaticResource ReadOnlyField}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Voucher Date:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dpEntryDate" Width="130" Margin="6,0,0,0"
                                IsEnabled="False"
                                helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=cmbEntryAcHead}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════ ENTRY BAND ═══════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource ItemEntryBand}" Margin="0,4,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Bottom">
                <Grid VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <!-- Account Head -->
                        <ColumnDefinition Width="240"/>
                        <!-- Narration -->
                        <ColumnDefinition Width="140"/>
                        <!-- Amount -->
                        <ColumnDefinition Width="150"/>
                        <!-- Mode -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Add -->
                    </Grid.ColumnDefinitions>


                    <!-- Account Head -->
                    <StackPanel Grid.Column="0" Margin="0,4,7,0">
                        <TextBlock Text="Account Head" Style="{StaticResource EntryFieldLabel}"/>
                        <controls:SmartComboBox
                            x:Name="cmbEntryAcHead"
                            IsEnabled="False"
                            DisplayMemberPath="AcHeadName"
                            SelectedValuePath="AcHeadCode"
                            TextSearch.TextPath="AcHeadName"
                            SearchPaths="AcHeadName,AcHeadCode"
                            TargetOnEnter="{Binding ElementName=cmbEntryNarration}"
                            helpers:FocusBehavior.TargetOnTab="{Binding ElementName=btnSave}"/>
                    </StackPanel>

                    <!-- Narration — free-typed, but suggests every narration
                         ever used on a prior journal line (see
                         JournalEntryRepository.GetDistinctNarrations). Not
                         bound to SelectedItem — Text is read directly at Add
                         time, so typing something brand new is always fine. -->
                    <StackPanel Grid.Column="1" Margin="0,4,7,0">
                        <TextBlock Text="Narration" Style="{StaticResource EntryFieldLabel}"/>
                        <controls:SmartComboBox
                            x:Name="cmbEntryNarration"
                            IsEnabled="False"
                            TargetOnEnter="{Binding ElementName=txtEntryAmount}"/>
                    </StackPanel>

                    <!-- Amount -->
                    <StackPanel Grid.Column="2" Margin="0,4,7,0">
                        <TextBlock Text="Amount" Style="{StaticResource EntryFieldLabel}"/>
                        <TextBox x:Name="txtEntryAmount" Text="0"
                                 IsEnabled="False"
                                 Style="{StaticResource EntryNumericField}"
                                 helpers:FocusBehavior.MoveOnEnter="True"/>
                    </StackPanel>

                    <!-- Mode -->
                    <StackPanel Grid.Column="3" Margin="0,4,7,0">
                        <TextBlock Text="Mode" Style="{StaticResource EntryFieldLabel}"/>
                        <ComboBox x:Name="cmbEntryMode" IsEnabled="False" SelectedIndex="0"
              helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnAddLine}">
                            <ComboBoxItem Content="Debit/Payment"/>
                            <ComboBoxItem Content="Credit/Receipt"/>
                        </ComboBox>
                    </StackPanel>


                    <!-- Add button -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="btnAddLine"
                                Content="＋ Add"
                                IsEnabled="False"
                                Click="BtnAddLine_Click"
                                Style="{StaticResource PrimaryOutlineButton}"
                                Width="90" Height="32" Margin="10,10,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════ LINES GRID ════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <syncfusion:SfDataGrid
                x:Name="sfLines"
                RowHeight="32"
                HeaderRowHeight="36"
                AutoGenerateColumns="False"
                AllowEditing="True"
                EditTrigger="OnTap"
                AllowSorting="False"
                AllowFiltering="False"
                AddNewRowPosition="None"
                NavigationMode="Row"
                SelectionMode="Single"
                ColumnSizer="None"
                AlternationCount="2"
                BorderThickness="0"
                ShowRowHeader="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <syncfusion:SfDataGrid.RowStyle>
                    <Style TargetType="syncfusion:VirtualizingCellsControl">
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </syncfusion:SfDataGrid.RowStyle>

                <syncfusion:SfDataGrid.AlternatingRowStyle>
                    <Style TargetType="syncfusion:VirtualizingCellsControl">
                        <Setter Property="Background" Value="#EFF6FF"/>
                    </Style>
                </syncfusion:SfDataGrid.AlternatingRowStyle>

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn    MappingName="AcHeadName"   HeaderText="Account Name" ColumnSizer="Star" MinimumWidth="200" AllowEditing="False"/>
                    <syncfusion:GridTextColumn    MappingName="Narration"    HeaderText="Narration"    ColumnSizer="Star" MinimumWidth="220" AllowEditing="False"/>
                    <syncfusion:GridNumericColumn MappingName="CreditAmount" HeaderText="Credit" Width="120" NumberDecimalDigits="2" />
                    <syncfusion:GridNumericColumn MappingName="DebitAmount"  HeaderText="Debit"  Width="120" NumberDecimalDigits="2" />

                    <!-- Delete row -->
                    <syncfusion:GridTemplateColumn HeaderText="" Width="45"
                        AllowEditing="False" AllowSorting="False" AllowFiltering="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GridDeleteButton}"
                                        Tag="{Binding}" Click="BtnDeleteLine_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Border>

        <!-- ═══════════════════════════ TOTALS FOOTER ═════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="15,10" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="lblBalanceWarning"
                           Text="Total Debit and Total Credit must match before this voucher can be saved."
                           Foreground="#B91C1C" FontSize="12" VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="Total Credit:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblTotalCredit" Text="0.00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Debit:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblTotalDebit" Text="0.00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════ ACTIONS ═══════════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnNew"     Content="_New"     Click="BtnNew_Click"     MinWidth="90" Margin="4"
                        Style="{StaticResource PrimaryOutlineButton}"/>
                <Button x:Name="btnSave"    Content="_Save"    Click="BtnSave_Click"    MinWidth="90" Margin="4"/>
                <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click" MinWidth="90" Margin="4"/>
                <Button x:Name="btnDelete"  Content="_Delete"  Click="BtnDelete_Click"  MinWidth="90" Margin="4"/>
                <Button x:Name="btnClose"   Content="Close"    MinWidth="90" Margin="4"
                        helpers:CloseTabBehavior.CloseOnClick="True"/>
            </StackPanel>
        </Border>

        <controls:GenericSearchOverlay x:Name="SearchOverlay" Grid.RowSpan="5" Visibility="Collapsed" Panel.ZIndex="999"/>
    </Grid>
</UserControl>
