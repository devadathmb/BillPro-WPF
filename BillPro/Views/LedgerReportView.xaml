<UserControl x:Class="BillPro.Views.LedgerReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:local="clr-namespace:BillPro.Views"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Distinguishes the synthetic "Opening Balance" reference row from
             real ledger rows — see LedgerReportView_xaml.cs's
             LedgerOpeningRowStyleSelector. Falls back to the grid's normal
             RowStyle/AlternatingRowStyle for every other row. -->
        <Style x:Key="OpeningBalanceRowStyle" TargetType="syncfusion:VirtualizingCellsControl">
            <Setter Property="Background" Value="#FEF3C7"/>
        </Style>
        <local:LedgerOpeningRowStyleSelector x:Key="LedgerOpeningRowStyleSelector"
                                              OpeningRowStyle="{StaticResource OpeningBalanceRowStyle}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <TextBlock Text="LEDGER REPORT (INDIVIDUAL ACCOUNT HEAD)"
                       FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
        </Border>

        <!-- Account head picker + current balance -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="15,10" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Account Head:" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <controls:SmartComboBox
                    x:Name="cmbAcHead" Grid.Column="1"
                    TextSearch.TextPath="AcHeadName"
                    SelectedValuePath="LedgerId"
                    SelectionChanged="CmbAcHead_SelectionChanged"
                    SearchPaths="AcHeadName,AcHeadCode">

                    <controls:SmartComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding AcHeadCode}"
                                       FontSize="12" Margin="4,2" Foreground="#6B7280"/>
                                <TextBlock Grid.Column="1" Text="{Binding AcHeadName}"
                                           FontSize="13" Margin="4,2" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </controls:SmartComboBox.ItemTemplate>
                </controls:SmartComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Current Balance" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblCurrentBalance" Text="—" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transaction grid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <DockPanel>
                <!-- Totals bar -->
                <Border DockPanel.Dock="Bottom" Background="#F9FAFB" BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0" Padding="15,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <TextBlock Text="Total Debit:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalDebit" Text="0.00" FontSize="14" FontWeight="Bold"
                                        Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <TextBlock Text="Total Credit:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalCredit" Text="0.00" FontSize="14" FontWeight="Bold"
                                        Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Closing Balance:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblClosingBalance" Text="0.00" FontSize="14" FontWeight="Bold"
                                        Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <syncfusion:SfDataGrid
                    x:Name="sfReport"
                    RowHeight="32"
                    HeaderRowHeight="36"
                    AutoGenerateColumns="False"
                    AllowEditing="False"
                    AllowSorting="True"
                    AllowFiltering="False"
                    AddNewRowPosition="None"
                    NavigationMode="Row"
                    SelectionMode="Single"
                    ColumnSizer="None"
                    AlternationCount="2"
                    BorderThickness="0"
                    ShowRowHeader="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    RowStyleSelector="{StaticResource LedgerOpeningRowStyleSelector}"
                    MouseDoubleClick="SfReport_MouseDoubleClick">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridDateTimeColumn MappingName="EntryDateValue"   HeaderText="Date"         Width="95"  Pattern="ShortDate"/>
                        <syncfusion:GridTextColumn     MappingName="TransactionType"  HeaderText="Type"        Width="120"/>
                        <syncfusion:GridTextColumn     MappingName="Narration"        HeaderText="Narration"   ColumnSizer="Star" MinimumWidth="150"/>
                        <syncfusion:GridNumericColumn  MappingName="Debit"            HeaderText="Debit"       Width="110" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn  MappingName="Credit"           HeaderText="Credit"      Width="110" NumberDecimalDigits="2"/>
                        <syncfusion:GridTextColumn     MappingName="RunningBalanceDisplay" HeaderText="Balance" Width="130"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <!-- Filter panel -->
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0" MaxHeight="240">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="From:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFromDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="To:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpToDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click"
                            Style="{StaticResource PrimaryOutlineButton}" MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPrint"   Content="Print" Click="BtnPrint_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPdf"     Content="PDF"   Click="BtnPdf_Click"     MinWidth="80" Margin="4"/>
                    <Button x:Name="btnExcel"   Content="Excel" Click="BtnExcel_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnClose"   Content="Close" MinWidth="80" Margin="4"
                            helpers:CloseTabBehavior.CloseOnClick="True"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
