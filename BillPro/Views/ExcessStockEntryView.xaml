<UserControl x:Class="BillPro.Views.ExcessStockEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header bar -->
            <RowDefinition Height="*"/>
            <!-- entry line + grid -->
            <RowDefinition Height="Auto"/>
            <!-- total row -->
            <RowDefinition Height="Auto"/>
            <!-- action buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — HEADER BAR (Entry No, Date, Remarks)
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="EXCESS STOCK ENTRY" FontSize="15" FontWeight="Bold"
                           Foreground="#059669" VerticalAlignment="Center" Margin="0,2,24,2"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Entry No:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtEntryNo" Width="90" IsReadOnly="True"
                             Background="#F3F4F6" FontWeight="Bold" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Entry Date:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dpEntryDate" Width="120" Margin="6,0,0,0"
                                IsEnabled="False"
                                helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=cmbEntryItemName}"
                                helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                FontSize="14" FontWeight="DemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2" MinWidth="300">
                    <TextBlock Text="Remarks:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtRemarks" Width="260" Margin="6,0,0,0" IsEnabled="False"
                             helpers:FocusBehavior.MoveOnEnter="True"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — ENTRY LINE + GRID
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ITEMS" Style="{StaticResource SectionHeader}"/>

                <!-- ── ITEM ENTRY LINE ─────────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource ItemEntryBand}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  VerticalContentAlignment="Bottom">
                        <Grid VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <!-- Item Name -->
                                <ColumnDefinition Width="100"/>
                                <!-- MRP -->
                                <ColumnDefinition Width="110"/>
                                <!-- Purchase Rate -->
                                <ColumnDefinition Width="100"/>
                                <!-- Qty -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Add -->
                            </Grid.ColumnDefinitions>

                            <!-- Item Name — picks an existing item/batch (auto-fills
                                 MRP + Purchase Rate below from that batch), or type a
                                 new MRP to create a brand-new batch: excess stock can
                                 legitimately be found for something never formally
                                 purchased. -->
                            <StackPanel Grid.Column="0" Margin="0,4,7,0">
                                <TextBlock Text="Item Name" Style="{StaticResource EntryFieldLabel}"/>
                                <controls:SmartComboBox
                                    x:Name="cmbEntryItemName"
                                    IsEnabled="False"
                                    TextSearch.TextPath="ItemName"
                                    SelectedValuePath="BatchId"
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AllItemBatches}"
                                    SelectionChanged="CmbEntryItemName_SelectionChanged"
                                    SearchPaths="ItemName,ItemCode,HsnCode,BatchNumber"
                                    TargetOnEnter="{Binding ElementName=txtEntryMrp}">

                                    <controls:SmartComboBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                                        BorderThickness="0,0,0,1" Padding="0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="70"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Code"          Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2"/>
                                                            <TextBlock Grid.Column="1" Text="Item Name"     Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2"/>
                                                            <TextBlock Grid.Column="2" Text="Batch"         Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2"/>
                                                            <TextBlock Grid.Column="3" Text="MRP"           Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="4" Text="Purch. Rate"   Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="5" Text="Stock"         Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2" TextAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </controls:SmartComboBox.GroupStyle>

                                    <controls:SmartComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ItemCode}"
                                                       FontSize="13" Margin="4,2" Foreground="#6B7280"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                                                           FontSize="13" Margin="4,2" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2"
                                                       Text="{Binding BatchNumber, TargetNullValue='(New Batch)'}"
                                                           FontSize="12" Margin="4,2" Foreground="#6B7280" FontStyle="Italic"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Mrp, StringFormat=N2}"
                                                           FontSize="12" Margin="4,2" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PurchaseRate, StringFormat=N2}"
                                                           FontSize="12" Margin="4,2" Foreground="#059669" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding CurrentQty, StringFormat='{}{0:N2}'}"
                                                           FontSize="12" Margin="4,2" Foreground="#6B7280" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </controls:SmartComboBox.ItemTemplate>
                                </controls:SmartComboBox>
                            </StackPanel>

                            <!-- MRP — editable: typing a new value here creates a
                                 brand-new batch for this item. -->
                            <StackPanel Grid.Column="1" Margin="0,4,7,0">
                                <TextBlock Text="MRP" Style="{StaticResource EntryFieldLabel}"/>
                                <TextBox x:Name="txtEntryMrp"
                                     IsEnabled="False"
                                     Style="{StaticResource EntryNumericField}"
                                     helpers:FocusBehavior.MoveOnEnter="True"/>
                            </StackPanel>

                            <!-- Purchase Rate -->
                            <StackPanel Grid.Column="2" Margin="0,4,7,0">
                                <TextBlock Text="Purchase Rate" Style="{StaticResource EntryFieldLabel}"/>
                                <TextBox x:Name="txtEntryPurchaseRate"
                                     IsEnabled="False"
                                     Style="{StaticResource EntryNumericField}"
                                     helpers:FocusBehavior.MoveOnEnter="True"/>
                            </StackPanel>

                            <!-- Qty -->
                            <StackPanel Grid.Column="3" Margin="0,4,7,0">
                                <TextBlock Text="Qty" Style="{StaticResource EntryFieldLabel}" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtEntryQty"
                                     IsEnabled="False"
                                     Style="{StaticResource EntryNumericField}"
                                     helpers:FocusBehavior.MoveOnEnter="True"/>
                            </StackPanel>

                            <!-- Add button -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,4,0,0">
                                <Button x:Name="btnAddItem"
                                    Content="＋ Add"
                                    IsEnabled="False"
                                    Click="BtnAddItem_Click"
                                    Style="{StaticResource PrimaryOutlineButton}"
                                    Width="90" Height="32" Margin="10,10,0,0"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- ── ITEMS GRID ────────────────────────────────────── -->
                <syncfusion:SfDataGrid
                    x:Name="sfItems"
                    Grid.Row="2"
                    MinHeight="200"
                    RowHeight="32"
                    HeaderRowHeight="36"
                    AutoGenerateColumns="False"
                    AllowEditing="True"
                    AddNewRowPosition="None"
                    AllowDeleting="True"
                    NavigationMode="Cell"
                    SelectionMode="Single"
                    ColumnSizer="None"
                    AlternationCount="2"
                    CurrentCellBeginEdit="SfItems_CurrentCellBeginEdit"
                    CurrentCellEndEdit="SfItems_CurrentCellEndEdit"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="SNo" HeaderText="SNo" Width="55" AllowEditing="False"/>
                        <syncfusion:GridTextColumn MappingName="ItemCode" HeaderText="Code" Width="90" AllowEditing="False"/>
                        <syncfusion:GridTextColumn MappingName="ItemName" HeaderText="Item Name" ColumnSizer="Star" MinimumWidth="190" AllowEditing="False"/>
                        <!-- MRP editable here too, for the same reason as the entry line above. -->
                        <syncfusion:GridNumericColumn MappingName="Mrp"          HeaderText="MRP"           Width="100" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn MappingName="PurchaseRate" HeaderText="Purchase Rate" Width="110" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn MappingName="Qty"         HeaderText="Qty"           Width="100" NumberDecimalDigits="3"/>

                        <!-- Delete row -->
                        <syncfusion:GridTemplateColumn HeaderText="" Width="45"
                            AllowEditing="False" AllowSorting="False" AllowFiltering="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GridDeleteButton}"
                                            Tag="{Binding}" Click="BtnDeleteItemRow_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — TOTAL ROW
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,4,0,0" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Total Purchase Rate:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTotalPurchaseRate" Text="0.00" FontWeight="Bold" VerticalAlignment="Center" Width="90" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Qty:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblTotalQty" Text="0.000" FontWeight="Bold" VerticalAlignment="Center" Width="90" TextAlignment="Right" Foreground="#059669"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 3 — ACTION BUTTONS
             ═══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,12">
            <Button x:Name="btnNew"     Content="New"    Click="BtnNew_Click"/>
            <Button x:Name="btnDisplay" Content="Display" Click="BtnDisplay_Click"/>
            <Button x:Name="btnSave"    Content="_Save"  Click="BtnSave_Click"
                    Style="{StaticResource PrimaryOutlineButton}" IsEnabled="False"/>
            <Button x:Name="btnCancelEntry" Content="Cancel Entry" Click="BtnCancelEntry_Click"
                    Style="{StaticResource DangerOutlineButton}" IsEnabled="False"/>
            <Button x:Name="btnClose"   Content="Close"
                    helpers:CloseTabBehavior.CloseOnClick="True" Margin="0"/>
        </StackPanel>

        <!-- Cancelled watermark — shown read-only over a cancelled entry.
             IsHitTestVisible="False" so it never blocks clicks underneath
             (fields are already disabled via DisableFields anyway). -->
        <Grid x:Name="pnlCancelledWatermark" Grid.RowSpan="4" Panel.ZIndex="500"
              IsHitTestVisible="False" Visibility="Collapsed" Background="Transparent">
            <TextBlock Text="CANCELLED"
                       FontSize="90" FontWeight="ExtraBold"
                       Foreground="#DC2626" Opacity="0.18"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-30"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Grid>

        <!-- Search overlay — spans all rows -->
        <controls:GenericSearchOverlay x:Name="SearchOverlay"
                                       Grid.RowSpan="4"
                                       Panel.ZIndex="999"
                                       Visibility="Collapsed"/>
    </Grid>
</UserControl>
