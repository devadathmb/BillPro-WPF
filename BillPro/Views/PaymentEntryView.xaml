<UserControl x:Class="BillPro.Views.PaymentEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BillPro.Views"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             Loaded="UserControl_Loaded"
             Background="#E9ECEF">

    <UserControl.Resources>
        <DataTemplate x:Key="AcHeadItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding AcHeadCode}" Padding="4,3"/>
                <TextBlock Grid.Column="1" Text="{Binding AcHeadName}" Padding="4,3" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Address}" Padding="4,3" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding Mobile}" Padding="4,3"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="White" Padding="20" Margin="15 0"
                CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1"
                HorizontalAlignment="Stretch" MaxWidth="900">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0 Payment No / Date -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1 A/c Head Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2 Address1 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3 Address2 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4 Mobile -->
                    <RowDefinition Height="Auto"/>
                    <!-- 5 GSTIN -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6 Narration -->
                    <RowDefinition Height="Auto"/>
                    <!-- 7 Payment Amount -->
                    <RowDefinition Height="Auto"/>
                    <!-- 8 Payment Mode -->
                    <RowDefinition Height="Auto"/>
                    <!-- 9 Bank panel -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <!-- buttons -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Payment No / Date -->
                <TextBlock Text="Payment No" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPaymentNo" Grid.Row="0" Grid.Column="1" IsEnabled="False" Margin="0 8" Width="120" HorizontalAlignment="Left"/>

                <TextBlock Text="Payment Date" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <DatePicker x:Name="DpPaymentDate" Grid.Row="0" Grid.Column="3" Margin="0 8" TabIndex="1"
                            helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=CmbAcHeadName}"/>

                <!-- A/c Head Name -->
                <TextBlock Text="A/c Head Name" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <controls:SmartComboBox x:Name="CmbAcHeadName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Margin="0 8" TabIndex="2" HorizontalAlignment="Stretch"
                         SelectedValuePath="AcHeadCode"
                         SearchPaths="AcHeadCode,AcHeadName,Address,Mobile"
                         TextSearch.TextPath="AcHeadName"
                         ItemTemplate="{StaticResource AcHeadItemTemplate}"
                         SelectionChanged="CmbAcHeadName_SelectionChanged"
                         TargetOnEnter="{Binding ElementName=TxtNarration}">
                    <controls:SmartComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="#DCE3EC">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Code" FontWeight="Bold" Padding="4,3"/>
                                        <TextBlock Grid.Column="1" Text="A/c Head Name" FontWeight="Bold" Padding="4,3"/>
                                        <TextBlock Grid.Column="2" Text="Address" FontWeight="Bold" Padding="4,3"/>
                                        <TextBlock Grid.Column="3" Text="Mobile" FontWeight="Bold" Padding="4,3"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </controls:SmartComboBox.GroupStyle>
                </controls:SmartComboBox>

                <!-- Address (read-only, auto filled) -->
                <TextBlock Text="Address" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtAddress1" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0 4" TabIndex="3"
                         helpers:FocusBehavior.MoveOnEnter="True"/>
                <TextBox x:Name="TxtAddress2" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0 4" TabIndex="4"
                         helpers:FocusBehavior.MoveOnEnter="True"/>

                <TextBlock Text="Mobile" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtMobile" Grid.Row="4" Grid.Column="1" Margin="0 8" TabIndex="5" HorizontalAlignment="Left" Width="200"
                         helpers:FocusBehavior.MoveOnEnter="True"/>

                <TextBlock Text="GSTIN" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtGstNo" Grid.Row="5" Grid.Column="1" Margin="0 8" TabIndex="6" HorizontalAlignment="Left" Width="200"
                         helpers:FocusBehavior.MoveOnEnter="True"/>

                <!-- Narration -->
                <TextBlock Text="Narration" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtNarration" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0 8" TabIndex="7"
                         helpers:FocusBehavior.MoveOnEnter="True"/>

                <!-- Amount -->
                <TextBlock Text="Payment Amount" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Foreground="#B00020" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtPaymentAmount" Grid.Row="7" Grid.Column="1" Margin="0 8" TabIndex="8" Width="180" HorizontalAlignment="Left"
                         helpers:TextBoxBehavior.IsDecimal="True"
                         helpers:TextBoxBehavior.SelectAllOnFocus="True"
                         helpers:FocusBehavior.MoveOnEnter="True"/>

                <TextBlock Text="Ledger Balance" Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtLedgerBalance" Grid.Row="7" Grid.Column="3" Margin="0 8" IsReadOnly="True" Background="#F2F2F2" IsTabStop="False"/>

                <!-- Payment Mode -->
                <TextBlock Text="Payment Mode" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbPaymentMode" Grid.Row="8" Grid.Column="1" Margin="0 8" Width="180" HorizontalAlignment="Left"
                          TabIndex="9" IsEditable="False" VerticalContentAlignment="Center"
                          SelectionChanged="CmbPaymentMode_SelectionChanged"
                            PreviewKeyDown="CmbPaymentMode_PreviewKeyDown">
                    <ComboBoxItem Content="Cash" IsSelected="True"/>
                    <ComboBoxItem Content="Bank"/>
                </ComboBox>

                <!-- Bank panel (visible only in Bank mode) -->
                <StackPanel x:Name="PnlBank" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Vertical" Visibility="Collapsed">
                    <Grid Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bank A/c Head" Grid.Column="0" VerticalAlignment="Center"/>
                        <controls:SmartComboBox x:Name="CmbBankAcHead" Grid.Column="1" Margin="0 4" TabIndex="10"
                                 DisplayMemberPath="AcHeadName" SelectedValuePath="AcHeadCode"
                                 SearchPaths="AcHeadCode,AcHeadName"
                                 TextSearch.TextPath="AcHeadName"
                                 MoveOnEnter="True"/>
                    </Grid>
                    <Grid Margin="0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bank Narration" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtBankNarration" Grid.Column="1" Margin="0 4" TabIndex="11"
                                 helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=BtnSave}"/>
                    </Grid>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="11" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnNew" Content="_New" Click="BtnNew_Click" TabIndex="12"/>
                    <Button x:Name="BtnDisplay" Content="_Display" Click="BtnDisplay_Click" TabIndex="16"/>
                    <Button x:Name="BtnSave" Content="_Save" Click="BtnSave_Click" TabIndex="13" Style="{StaticResource PrimaryOutlineButton}" IsEnabled="False"/>
                    <Button x:Name="BtnPrint" Content="_Print" Click="BtnPrint_Click" TabIndex="14" IsEnabled="False"/>
                    <Button x:Name="BtnPdf" Content="_PDF" Click="BtnPdf_Click" TabIndex="15" IsEnabled="False"/>
                    <Button x:Name="BtnCancel" Content="Cancel Bill" Click="BtnCancel_Click" TabIndex="17" Style="{StaticResource DangerOutlineButton}" IsEnabled="False"/>
                    <Button x:Name="BtnClose" Content="_Close" helpers:CloseTabBehavior.CloseOnClick="True" TabIndex="18" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cancelled watermark — shown over the form Border, form fields
             (including Save/Update) are disabled in code-behind whenever
             this is visible so a cancelled voucher can't be edited. -->
        <Border x:Name="PnlCancelledWatermark" Grid.Row="1" Margin="15 0" MaxWidth="900"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock Text="CANCELLED" FontSize="72" FontWeight="Bold"
                       Foreground="#33CC0000" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-30"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>

        <controls:GenericSearchOverlay x:Name="SearchOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="999" Visibility="Collapsed"/>
    </Grid>
</UserControl>
