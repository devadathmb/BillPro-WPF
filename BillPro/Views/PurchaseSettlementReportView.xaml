<UserControl x:Class="BillPro.Views.PurchaseSettlementReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:views="clr-namespace:BillPro.Views"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <views:GreaterThanZeroConverter x:Key="CreditGreaterThanZeroConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <TextBlock Text="CASH / BANK / CREDIT SETTLEMENT REPORT"
                       FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Tip: double-click or right-click a row for full bill details / edit. Rows with an outstanding Credit amount are highlighted."
                       FontSize="10.5" Foreground="#9CA3AF" Margin="10,3" HorizontalAlignment="Left"/>
                <syncfusion:SfDataGrid
                x:Name="sfReport"
                RowHeight="32"
                HeaderRowHeight="36"
                AutoGenerateColumns="False"
                AllowEditing="False"
                AllowSorting="True"
                AllowFiltering="False"
                AddNewRowPosition="None"
                NavigationMode="Row"
                SelectionMode="Single"
                ColumnSizer="None"
                AlternationCount="2"
                BorderThickness="0"
                ShowRowHeader="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                MouseDoubleClick="SfReport_MouseDoubleClick">

                    <syncfusion:SfDataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit This Bill" Click="MenuEditBill_Click"/>
                            <MenuItem Header="View Details"   Click="MenuViewDetails_Click"/>
                            <Separator/>
                            <MenuItem Header="Copy Bill No"    Click="MenuCopyBillNo_Click"/>
                        </ContextMenu>
                    </syncfusion:SfDataGrid.ContextMenu>

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <!-- Credit-heavy bills (still owing money to the vendor) get a
                     soft red tint so they visually stand out from fully-settled
                     bills, without the user needing to read the numbers. -->
                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridDateTimeColumn MappingName="PurchaseDate" HeaderText="Pur Date"  Width="95"  Pattern="ShortDate"/>
                        <syncfusion:GridTextColumn     MappingName="BillNo"       HeaderText="Bill No"    Width="110"/>
                        <syncfusion:GridTextColumn     MappingName="VendorName"   HeaderText="Supplier"   ColumnSizer="Star" MinimumWidth="180"/>
                        <syncfusion:GridNumericColumn  MappingName="NetTotal"     HeaderText="Net Total"  Width="110" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn  MappingName="ToCash"       HeaderText="Cash"       Width="100" NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn  MappingName="ToBank"       HeaderText="Bank"       Width="100" NumberDecimalDigits="2"/>
                        <syncfusion:GridTextColumn     MappingName="BankHeadName" HeaderText="Bank Name"  Width="130"/>
                        <syncfusion:GridNumericColumn  MappingName="ToCredit"     HeaderText="Credit"     Width="100" NumberDecimalDigits="2">
                            <syncfusion:GridNumericColumn.CellStyle>
                                <Style TargetType="syncfusion:GridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToCredit, Converter={StaticResource CreditGreaterThanZeroConverter}}" Value="True">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:GridNumericColumn.CellStyle>
                        </syncfusion:GridNumericColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0"
                BorderBrush="#111827" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Cash" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblTotalCash" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Text="Bank" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblTotalBank" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Text="Credit" FontSize="11" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblTotalCredit" FontSize="14" FontWeight="SemiBold" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Net Total" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblGrandTotal" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0" MaxHeight="240">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="From:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFromDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="To:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpToDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                            <TextBlock Text="Search:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtVendorSearch" Width="180" Margin="6,0,0,0"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     helpers:TextBoxBehavior.SelectAllOnFocus="True"
                                     ToolTip="Supplier name, GST No, or Bill No"
                                     KeyDown="TxtVendorSearch_KeyDown"/>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click"
                            Style="{StaticResource PrimaryOutlineButton}" MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPrint"   Content="Print" Click="BtnPrint_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPdf"     Content="PDF"   Click="BtnPdf_Click"     MinWidth="80" Margin="4"/>
                    <Button x:Name="btnExcel"   Content="Excel" Click="BtnExcel_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnClose"   Content="Close" MinWidth="80" Margin="4"
                            helpers:CloseTabBehavior.CloseOnClick="True"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
