<UserControl x:Class="BillPro.Views.HSNCodeRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             Loaded="UserControl_Loaded"
             Background="#E9ECEF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="White" Padding="20" Margin="15,0,15,0"
                CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1"
                HorizontalAlignment="Stretch" MaxWidth="600">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="HSN Code" Grid.Row="0" Grid.Column="0" />
                <TextBox x:Name="txtHsnCode" Grid.Row="0" Grid.Column="1" IsEnabled="False" TabIndex="1" Margin="0 8"
                         helpers:FocusBehavior.MoveOnEnter="True"
                         helpers:TextBoxBehavior.IsDecimal="True"
                         helpers:TextBoxBehavior.SelectAllOnFocus="True"/>


                <TextBlock Text="Item Description" Grid.Row="1" Grid.Column="0" />
                <TextBox x:Name="txtDescription" Grid.Row="1" Grid.Column="1" IsEnabled="False" TabIndex="2" Margin="0 8"
                         helpers:FocusBehavior.MoveOnEnter="True"
                         helpers:TextBoxBehavior.SelectAllOnFocus="True"/>

                <TextBlock Text="Tax Rate (%)" Grid.Row="2" Grid.Column="0" Foreground="Blue" />
                <TextBox x:Name="txtTaxRate" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="100" IsEnabled="False" TabIndex="3" Margin="0 8" TextAlignment="Center"
                         helpers:FocusBehavior.TargetOnEnter="{Binding ElementName = btnSave}" Foreground="Blue" FontWeight="DemiBold"
                         helpers:TextBoxBehavior.IsDecimal="True"
                         helpers:TextBoxBehavior.SelectAllOnFocus="True"/>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnNew" Content="_New" Click="BtnNew_Click" TabIndex="0"/>
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click" TabIndex="5"/>
                    <Button x:Name="btnSave" Content="_Save" Click="BtnSave_Click" TabIndex="4" Style="{StaticResource PrimaryOutlineButton}" IsEnabled="False"/>
                    <Button x:Name="btnDelete" Content="_Delete" Click="BtnDelete_Click" TabIndex="6" Style="{StaticResource DangerOutlineButton}" IsEnabled="False"/>
                    <Button x:Name="btnClose" Content="_Close" helpers:CloseTabBehavior.CloseOnClick="True" TabIndex="7" Margin="0"/>
                </StackPanel>

            </Grid>
        </Border>
        <controls:GenericSearchOverlay x:Name="SearchOverlay"  Grid.RowSpan="3" Panel.ZIndex="999" />

    </Grid>
</UserControl>