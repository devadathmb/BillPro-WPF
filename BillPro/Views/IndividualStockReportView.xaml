<UserControl x:Class="BillPro.Views.IndividualStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:local="clr-namespace:BillPro.Views"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Distinguishes the synthetic "Opening Balance" reference row from
             real ledger rows — see IndividualStockReportView_xaml.cs's
             OpeningRowStyleSelector. Falls back to the grid's normal
             RowStyle/AlternatingRowStyle for every other row. -->
        <Style x:Key="OpeningBalanceRowStyle" TargetType="syncfusion:VirtualizingCellsControl">
            <Setter Property="Background" Value="#FEF3C7"/>
        </Style>
        <local:OpeningRowStyleSelector x:Key="OpeningRowStyleSelector"
                                        OpeningRowStyle="{StaticResource OpeningBalanceRowStyle}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <TextBlock Text="INDIVIDUAL STOCK REPORT"
                       FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
        </Border>

        <!-- Item/batch picker + current snapshot -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="15,10" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Item / Batch:" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <controls:SmartComboBox
                    x:Name="cmbItemBatch" Grid.Column="1"
                    TextSearch.TextPath="ItemName"
                    SelectedValuePath="BatchId"
                    SelectionChanged="CmbItemBatch_SelectionChanged"
                    SearchPaths="ItemName,ItemCode,HsnCode,BatchNumber">

                    <controls:SmartComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Code"   Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2"/>
                                            <TextBlock Grid.Column="1" Text="Item Name" Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2"/>
                                            <TextBlock Grid.Column="2" Text="Batch"  Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2"/>
                                            <TextBlock Grid.Column="3" Text="MRP"    Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="Stock"  Style="{StaticResource EntryFieldLabel}" FontWeight="Bold" Foreground="#4B5563" Margin="4,2" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </controls:SmartComboBox.GroupStyle>

                    <controls:SmartComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ItemCode}"
                                       FontSize="13" Margin="4,2" Foreground="#6B7280"/>
                                <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                                           FontSize="13" Margin="4,2" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding BatchNumber}"
                                           FontSize="12" Margin="4,2" Foreground="#6B7280" FontStyle="Italic"/>
                                <TextBlock Grid.Column="3" Text="{Binding Mrp, StringFormat=N2}"
                                           FontSize="12" Margin="4,2" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{Binding CurrentQty, StringFormat='{}{0:N2}'}"
                                           FontSize="12" Margin="4,2" Foreground="#6B7280" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </controls:SmartComboBox.ItemTemplate>
                </controls:SmartComboBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Combine-all-batches toggle — when on, the report shows
                         every batch (every MRP) of the picked item merged into
                         one chronological history/running balance instead of
                         just the single batch selected above. The combo above
                         still drives WHICH ITEM is being reported on; only the
                         batch scope changes. -->
                    <CheckBox x:Name="chkCombineBatches"
                              Content="Combine all batches"
                              VerticalAlignment="Center"
                              Checked="ChkCombineBatches_CheckedChanged"
                              Unchecked="ChkCombineBatches_CheckedChanged"
                              ToolTip="Show this item's full transaction history across every MRP/batch, merged into one running balance."/>

                    <!-- Checked by default: batches/items with 0 current stock
                         (including brand-new items that have never been
                         purchased/produced/sold) are hidden from the picker
                         above unless the user explicitly asks to see them. -->
                    <CheckBox x:Name="chkHideZeroStock"
                              Content="Hide items with 0 stock"
                              IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                              Checked="ChkHideZeroStock_CheckedChanged"
                              Unchecked="ChkHideZeroStock_CheckedChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="MRP" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblMrp" Text="—" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Current Stock" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblCurrentStock" Text="—" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Stock Value" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblCurrentValue" Text="—" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transaction grid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Tip: double-click or right-click a row to open the source document it came from (where available)."
                       FontSize="10.5" Foreground="#9CA3AF" Margin="10,3" HorizontalAlignment="Left"/>

                <!-- Totals bar — Qty In / Qty Out only. Running balance isn't
                     repeated here since it's already shown as Current Stock
                     up top; duplicating it here would just be the same
                     number read a different way. Kept out of the grid/print
                     rows entirely (see ApplyFilterToDisplay) so the exported
                     table stays pure transaction history and this summary
                     line doesn't get double-counted alongside itself. -->
                <Border DockPanel.Dock="Bottom" Background="#F9FAFB" BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0" Padding="15,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <TextBlock Text="Total Qty In:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalQtyIn" Text="0.00" FontSize="14" FontWeight="Bold"
                                        Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                            <TextBlock Text="Total Qty Out:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalQtyOut" Text="0.00" FontSize="14" FontWeight="Bold"
                                        Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Closing Stock:" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblClosingStock" Text="0.00" FontSize="14" FontWeight="Bold"
                                        Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <syncfusion:SfDataGrid
                    x:Name="sfReport"
                    RowHeight="32"
                    HeaderRowHeight="36"
                    AutoGenerateColumns="False"
                    AllowEditing="False"
                    AllowSorting="True"
                    AllowFiltering="False"
                    AddNewRowPosition="None"
                    NavigationMode="Row"
                    SelectionMode="Single"
                    ColumnSizer="None"
                    AlternationCount="2"
                    BorderThickness="0"
                    ShowRowHeader="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    RowStyleSelector="{StaticResource OpeningRowStyleSelector}"
                    MouseDoubleClick="SfReport_MouseDoubleClick">

                    <syncfusion:SfDataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Source Document" Click="MenuOpenSource_Click"/>
                            <Separator/>
                            <MenuItem Header="Copy Source No" Click="MenuCopySource_Click"/>
                        </ContextMenu>
                    </syncfusion:SfDataGrid.ContextMenu>

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn     MappingName="SourceDisplayNo" HeaderText="Source Document"  Width="150"/>
                        <syncfusion:GridDateTimeColumn MappingName="TransDate"       HeaderText="Date"    Width="95"  Pattern="ShortDate"/>
                        <syncfusion:GridTextColumn     MappingName="TransTypeLabel"  HeaderText="Type"   ColumnSizer="Star" MinimumWidth="130"/>
                        <!-- Batch — always shown. Redundant (same value on
                             every row) in single-batch mode, but that's
                             harmless; it's the column that actually
                             distinguishes rows once "Combine all batches" is
                             on and multiple MRPs are mixed together. -->
                        <syncfusion:GridTextColumn     MappingName="BatchNumber"     HeaderText="Batch"   Width="100"/>
                        <syncfusion:GridNumericColumn  MappingName="Mrp"             HeaderText="MRP"     Width="85"  NumberDecimalDigits="2"/>
                        <syncfusion:GridNumericColumn  MappingName="QtyIn"           HeaderText="Qty In"  Width="100" NumberDecimalDigits="3"/>
                        <syncfusion:GridNumericColumn  MappingName="QtyOut"          HeaderText="Qty Out" Width="100" NumberDecimalDigits="3"/>
                        <syncfusion:GridNumericColumn  MappingName="RunningBalance"  HeaderText="Balance" Width="130" NumberDecimalDigits="3"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Border>

        <!-- Filter panel -->
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0" MaxHeight="240">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="From:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFromDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="To:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpToDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                            <TextBlock Text="Type:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <controls:MultiSelectFilterControl x:Name="modeFilter" Margin="6,0,0,0"
                                                                SelectionChanged="Filter_Changed"/>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click"
                            Style="{StaticResource PrimaryOutlineButton}" MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPrint"   Content="Print" Click="BtnPrint_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPdf"     Content="PDF"   Click="BtnPdf_Click"     MinWidth="80" Margin="4"/>
                    <Button x:Name="btnExcel"   Content="Excel" Click="BtnExcel_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnClose"   Content="Close" MinWidth="80" Margin="4"
                            helpers:CloseTabBehavior.CloseOnClick="True"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
