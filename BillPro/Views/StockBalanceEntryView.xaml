<UserControl x:Class="BillPro.Views.StockBalanceEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- title -->
            <RowDefinition Height="*"/>
            <!-- two grids side by side -->
            <RowDefinition Height="Auto"/>
            <!-- reference values band -->
            <RowDefinition Height="Auto"/>
            <!-- divider -->
            <RowDefinition Height="Auto"/>
            <!-- action buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             TITLE
             ═══════════════════════════════════════════════════════════ -->
        <TextBlock Grid.Row="0" Text="OPENING / CLOSING STOCK — BALANCE ENTRY"
                   FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"
                   Margin="0,0,0,12"/>

        <!-- ═══════════════════════════════════════════════════════════
             TWO HALVES — Opening Stock heads (left) / Closing Stock
             heads (right). Same editable OpeningDebit/OpeningCredit
             columns as OpeningBalanceEntryView's grid — this screen is
             just that pattern, filtered to the two reserved stock
             categories and split side by side instead of one long list.
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ OPENING STOCK (left) ═══════════════ -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#DCE7FB" Padding="8,6">
                    <TextBlock Text="OPENING STOCK HEADS" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" Foreground="#1D4ED8"/>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="#F3F4F6" BorderBrush="#E5E7EB"
                        BorderThickness="1,0,1,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ENTERED TOTAL" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblOpeningEnteredTotal" Grid.Column="1" FontWeight="Bold"
                                   TextAlignment="Right" VerticalAlignment="Center" Text="0.00"/>
                    </Grid>
                </Border>

                <syncfusion:SfDataGrid
                    x:Name="dgOpeningHeads"
                    AutoGenerateColumns="False"
                    AllowEditing="True"
                    AddNewRowPosition="None"
                    AllowDeleting="False"
                    AllowSorting="True"
                    AllowFiltering="False"
                    NavigationMode="Cell"
                    SelectionMode="Single"
                    ColumnSizer="None"
                    AlternationCount="2"
                    RowHeight="30"
                    HeaderRowHeight="32"
                    BorderThickness="1"
                    BorderBrush="#E5E7EB"
                    Background="#FFFFFF"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    CurrentCellEndEdit="DgHeads_CurrentCellEndEdit">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="AcHeadCode" HeaderText="Code" Width="70" AllowEditing="False"/>
                        <syncfusion:GridTextColumn MappingName="AcHeadName" HeaderText="A/c Head Name"
                                                   ColumnSizer="Star" MinimumWidth="160" AllowEditing="False"/>
                        <syncfusion:GridNumericColumn MappingName="OpeningDebit" HeaderText="Opening Debit"
                                                      Width="130" NumberDecimalDigits="2" TextAlignment="Right"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>

            <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

            <!-- ═══════════════ CLOSING STOCK (right) ═══════════════ -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#DCE7FB" Padding="8,6">
                    <TextBlock Text="CLOSING STOCK HEADS" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" Foreground="#1D4ED8"/>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="#F3F4F6" BorderBrush="#E5E7EB"
                        BorderThickness="1,0,1,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ENTERED TOTAL" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblClosingEnteredTotal" Grid.Column="1" FontWeight="Bold"
                                   TextAlignment="Right" VerticalAlignment="Center" Text="0.00"/>
                    </Grid>
                </Border>

                <syncfusion:SfDataGrid
                    x:Name="dgClosingHeads"
                    AutoGenerateColumns="False"
                    AllowEditing="True"
                    AddNewRowPosition="None"
                    AllowDeleting="False"
                    AllowSorting="True"
                    AllowFiltering="False"
                    NavigationMode="Cell"
                    SelectionMode="Single"
                    ColumnSizer="None"
                    AlternationCount="2"
                    RowHeight="30"
                    HeaderRowHeight="32"
                    BorderThickness="1"
                    BorderBrush="#E5E7EB"
                    Background="#FFFFFF"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    CurrentCellEndEdit="DgHeads_CurrentCellEndEdit">

                    <syncfusion:SfDataGrid.RowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </syncfusion:SfDataGrid.RowStyle>

                    <syncfusion:SfDataGrid.AlternatingRowStyle>
                        <Style TargetType="syncfusion:VirtualizingCellsControl">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </syncfusion:SfDataGrid.AlternatingRowStyle>

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="AcHeadCode" HeaderText="Code" Width="70" AllowEditing="False"/>
                        <syncfusion:GridTextColumn MappingName="AcHeadName" HeaderText="A/c Head Name"
                                                   ColumnSizer="Star" MinimumWidth="160" AllowEditing="False"/>
                        <syncfusion:GridNumericColumn MappingName="OpeningCredit" HeaderText="Opening Credit"
                                                      Width="130" NumberDecimalDigits="2" TextAlignment="Right"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </DockPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             REFERENCE VALUES — pulled straight from the Opening Stock
             Report and Current Stock Report's own grand totals. Purely
             informational: NOT wired into Save, NOT part of any
             accounting calculation — just so whoever's punching in the
             heads above knows the figure inventory says they should be
             matching (e.g. splitting across "Opening Stock 18%",
             "Opening Stock 12%" etc. so the Entered Total above lines
             up with this).
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                Padding="16,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Opening Stock Value — per Opening Stock Report (reference only)"
                               FontSize="11" Foreground="#374151" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblOpeningReportValue" FontSize="16" FontWeight="Bold" Text="0.00"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Margin="20,0" Background="#93C5FD"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Closing Stock Value — per Current Stock Report, as of today (reference only)"
                               FontSize="11" Foreground="#374151" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblClosingReportValue" FontSize="16" FontWeight="Bold" Text="0.00"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Height="1" Background="#E5E7EB" Margin="0,12,0,12"/>

        <!-- ═══════════════════════════════════════════════════════════
             ACTION BUTTONS
             ═══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSaveAll" Content="_Save All" Click="BtnSaveAll_Click"
                    Style="{StaticResource PrimaryOutlineButton}"/>
            <Button x:Name="btnClose" Content="Close" Margin="0" helpers:CloseTabBehavior.CloseOnClick="True"/>
        </StackPanel>
    </Grid>
</UserControl>
