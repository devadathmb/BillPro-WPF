<UserControl x:Class="BillPro.Views.OpeningStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:controls="clr-namespace:BillPro.Controls"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <!-- ═══════════════════════════════════════════════════════════════════
         REUSABLE REPORT TEMPLATE
         Row 0: Title bar
         Row 1: Report grid (fills remaining space)
         Row 2: Totals footer — free-form, matches ReportPdfHelper's footer
         Row 3: Bottom panel — filters (left) + action buttons (right)
         Copy this file for future reports: swap the title, the grid columns,
         the filter controls, the footer totals, and the repository call in
         BtnDisplay_Click / LoadReport.
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── ROW 0 — TITLE BAR ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <TextBlock Text="OPENING STOCK REPORT (Batch-wise)"
                       FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
        </Border>

        <!-- ── ROW 1 — REPORT GRID ───────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <syncfusion:SfDataGrid
                x:Name="sfReport"
                RowHeight="32"
                HeaderRowHeight="36"
                AutoGenerateColumns="False"
                AllowEditing="False"
                AllowSorting="True"
                AllowFiltering="False"
                AddNewRowPosition="None"
                NavigationMode="Row"
                SelectionMode="Single"
                ColumnSizer="None"
                AlternationCount="2"
                BorderThickness="0"
                ShowRowHeader="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <syncfusion:SfDataGrid.RowStyle>
                    <Style TargetType="syncfusion:VirtualizingCellsControl">
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </syncfusion:SfDataGrid.RowStyle>

                <syncfusion:SfDataGrid.AlternatingRowStyle>
                    <Style TargetType="syncfusion:VirtualizingCellsControl">
                        <Setter Property="Background" Value="#EFF6FF"/>
                    </Style>
                </syncfusion:SfDataGrid.AlternatingRowStyle>

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn    MappingName="ItemCode"       HeaderText="Code"          Width="90"/>
                    <syncfusion:GridTextColumn    MappingName="ItemName"       HeaderText="Item Name"     ColumnSizer="Star" MinimumWidth="220"/>
                    <syncfusion:GridNumericColumn MappingName="Mrp"            HeaderText="MRP"           Width="90"  NumberDecimalDigits="2"/>
                    <syncfusion:GridNumericColumn MappingName="SalesRate"      HeaderText="Sales Rate"    Width="100" NumberDecimalDigits="2"/>
                    <syncfusion:GridNumericColumn MappingName="PurchaseRate"   HeaderText="Purchase Rate" Width="110" NumberDecimalDigits="2"/>
                    <syncfusion:GridNumericColumn MappingName="TotalQty"       HeaderText="Opening Qty"   Width="110" NumberDecimalDigits="3"/>
                    <syncfusion:GridNumericColumn MappingName="Amount"         HeaderText="Amount"        Width="120" NumberDecimalDigits="2"/>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Border>

        <!-- ── ROW 2 — TOTALS FOOTER — free-form, no grid row-height ceiling ──
             On-screen twin of ReportPdfHelper's footer: a rule line, then
             right-aligned bold totals below it. Deliberately NOT a
             GridTableSummaryRow — that system fights back on font size and
             caps line height to whatever the grid's row template allows. A
             plain Border+TextBlock has none of those constraints. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0"
                BorderBrush="#111827" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock x:Name="lblGrandTotalQty" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Right" Margin="0,0,0,4"/>
                <TextBlock x:Name="lblGrandTotalAmount" FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- ── ROW 3 — BOTTOM PANEL: FILTERS (left) | divider | ACTIONS (right) ─
             Both columns use "*" (proportional), NOT "Auto" — this is the
             key fix. An Auto column always sizes to its content's natural
             single-line width first and takes that space unconditionally,
             which is what starved the filters last time. Star columns are
             genuinely bounded by the real remaining width, so the button
             WrapPanel actually reflows against real available space: one
             line if there's room, wraps into rows if there isn't — the same
             logic as a CSS flex-wrap. Vertically centered either way. -->
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0"
                MaxHeight="240">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Filters — left. Uses the same label/control widths as
                     CurrentStockReportView so both reports look consistent,
                     even though this one currently only has one filter. -->
                <ScrollViewer Grid.Column="0" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">

                        <!-- ── FINANCIAL YEAR FILTER (not implemented yet) ──────────────
                             Once the Financial Year setting exists, this report should
                             only show opening-stock movements from the FY start date
                             onward. Until then it simply shows everything since
                             inception (no date filter). Re-enable a From/To/Show-All
                             filter row here — matching the controls below — once
                             FinancialYearRepository (or equivalent) is available.

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="From:" Width="85" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFromDate" Width="150" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="To:" Width="85" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpToDate" Width="150" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <CheckBox x:Name="chkShowAll" Content="Show All Dates" Checked="ChkShowAll_CheckedChanged" Unchecked="ChkShowAll_CheckedChanged"/>
                        </StackPanel>
                        -->

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                            <TextBlock Text="Item Search:" Width="85" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtItemSearch" Width="150" Margin="6,0,0,0"
                                     helpers:FocusBehavior.MoveOnEnter="True"
                                     helpers:TextBoxBehavior.SelectAllOnFocus="True"
                                     KeyDown="TxtItemSearch_KeyDown"/>
                        </StackPanel>

                    </WrapPanel>
                </ScrollViewer>

                <!-- Divider -->
                <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

                <!-- Actions — right. WrapPanel genuinely reflows: single line
                     when the column is wide enough, wraps into a second row
                     (centered as a block either way) when it isn't. -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click"
                            Style="{StaticResource PrimaryOutlineButton}" MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPrint"   Content="Print" Click="BtnPrint_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPdf"     Content="PDF"   Click="BtnPdf_Click"     MinWidth="80" Margin="4"/>
                    <Button x:Name="btnExcel"   Content="Excel" Click="BtnExcel_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnClose"   Content="Close" MinWidth="80" Margin="4"
                            helpers:CloseTabBehavior.CloseOnClick="True"/>
                </WrapPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
