<UserControl x:Class="BillPro.Views.TradingProfitLossReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BillPro.Helpers"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="#E9ECEF"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="15,10">
            <TextBlock Text="TRADING AND PROFIT &amp; LOSS A/C"
                       FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom"
                       Text="Direct (trading) items are totalled first into a dedicated Gross Profit/Loss c/d row, then brought down against indirect items — closed with its own Net Profit/Loss row — so both sides balance at each stage."
                       FontSize="10.5" Foreground="#9CA3AF" Margin="10,3" HorizontalAlignment="Left"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══════════════ EXPENSES (left) ═══════════════ -->
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Top" Background="#DCE7FB" Padding="8,6">
                            <TextBlock Text="EXPENSES" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="#1D4ED8"/>
                        </Border>
                        <syncfusion:SfDataGrid
                            x:Name="sfExpense"
                            RowHeight="30"
                            HeaderRowHeight="30"
                            AutoGenerateColumns="False"
                            AllowEditing="False"
                            AllowSorting="False"
                            AllowFiltering="False"
                            AddNewRowPosition="None"
                            NavigationMode="Row"
                            SelectionMode="Single"
                            ColumnSizer="Star"
                            AlternationCount="2"
                            AllowGrouping="False"
                            BorderThickness="0"
                            ShowRowHeader="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <syncfusion:SfDataGrid.RowStyle>
                                <Style TargetType="syncfusion:VirtualizingCellsControl">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsGrossProfitRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBalancingRow}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:SfDataGrid.RowStyle>

                            <syncfusion:SfDataGrid.AlternatingRowStyle>
                                <Style TargetType="syncfusion:VirtualizingCellsControl">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsGrossProfitRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBalancingRow}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:SfDataGrid.AlternatingRowStyle>

                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn MappingName="ExpenseParticulars" HeaderText="Particulars" Width="220"/>
                                <syncfusion:GridTextColumn MappingName="ExpenseAmountLabel" HeaderText="Amount" TextAlignment="Right" ColumnSizer="Star" MinimumWidth="120"/>
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </DockPanel>

                    <Border Grid.Column="1" Width="6" Margin="1,0"  BorderBrush="#111827" BorderThickness="2"/>

                    <!-- ═══════════════ INCOME (right) ═══════════════ -->
                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top" Background="#DCE7FB" Padding="8,6">
                            <TextBlock Text="INCOME" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="#1D4ED8"/>
                        </Border>
                        <syncfusion:SfDataGrid
                            x:Name="sfIncome"
                            RowHeight="30"
                            HeaderRowHeight="30"
                            AutoGenerateColumns="False"
                            AllowEditing="False"
                            AllowSorting="False"
                            AllowFiltering="False"
                            AddNewRowPosition="None"
                            NavigationMode="Row"
                            SelectionMode="Single"
                            ColumnSizer="Star"
                            AlternationCount="2"
                            AllowGrouping="False"
                            BorderThickness="0"
                            ShowRowHeader="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <syncfusion:SfDataGrid.RowStyle>
                                <Style TargetType="syncfusion:VirtualizingCellsControl">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsGrossProfitRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBalancingRow}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:SfDataGrid.RowStyle>

                            <syncfusion:SfDataGrid.AlternatingRowStyle>
                                <Style TargetType="syncfusion:VirtualizingCellsControl">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsGrossProfitRow}" Value="True">
                                            <Setter Property="Background" Value="#DCE7FB"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBalancingRow}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </syncfusion:SfDataGrid.AlternatingRowStyle>

                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn MappingName="IncomeParticulars" HeaderText="Particulars" Width="220"/>
                                <syncfusion:GridTextColumn MappingName="IncomeAmountLabel" HeaderText="Amount" TextAlignment="Right" ColumnSizer="Star" MinimumWidth="120"/>
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,4,0,0"
                BorderBrush="#111827" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel HorizontalAlignment="Right">
                <Grid HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,36,0">
                        <TextBlock Text="Total Expense" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblTotalExpense" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total Income" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblTotalIncome" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Only shown when the two sides don't tie out — collapsed
                     (and left out of Print/PDF/Excel footers) whenever the
                     difference is zero, see LoadReport/BuildFooterLines. -->
                <StackPanel x:Name="lblDifferencePanel" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock Text="Difference: " FontWeight="DemiBold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblDifference" FontWeight="Bold" Foreground="#B91C1C"
                               VerticalAlignment="Center" Width="120" TextAlignment="Right" Text="0.00"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="15,10" Margin="0,4,0,0" MaxHeight="200">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="From:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpFromDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                            <TextBlock Text="To:" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpToDate" Width="140" Margin="6,0,0,0"
                                        helpers:DatePickerOverwriteBehavior.IsEnabled="True"
                                        SelectedDateChanged="Filter_Changed"/>
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Width="1" Margin="16,2" Background="#D1D5DB"/>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnDisplay" Content="_Display" Click="BtnDisplay_Click"
                            Style="{StaticResource PrimaryOutlineButton}" MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPrint"   Content="Print" Click="BtnPrint_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnPdf"     Content="PDF"   Click="BtnPdf_Click"     MinWidth="80" Margin="4"/>
                    <Button x:Name="btnExcel"   Content="Excel" Click="BtnExcel_Click"   MinWidth="80" Margin="4"/>
                    <Button x:Name="btnClose"   Content="Close" MinWidth="80" Margin="4"
                            helpers:CloseTabBehavior.CloseOnClick="True"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
