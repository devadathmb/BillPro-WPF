<UserControl x:Class="BillPro.Views.ItemRegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillPro.Controls"
        xmlns:helpers="clr-namespace:BillPro.Helpers">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="15,0,15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Item Code" Grid.Row="0" Grid.Column="0" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBox x:Name="txtItemCode" Width="150" Margin="0,0,15,0" 
                         helpers:FocusBehavior.MoveOnEnter="True"/>

                <TextBlock Text="HSN Code:" Margin="0,0,10,0"/>
                <controls:SmartComboBox x:Name="cmbHsnCode" 
                        TextSearch.TextPath="HsnCode"
                        SelectedValuePath="HsnCode"
                        SearchPaths="HsnCode,ItemDescription"
                        SelectionChanged="CmbHsnCode_SelectionChanged"
                        Width="100" 
                        MoveOnEnter="True">
                    <controls:SmartComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="HSN"  FontWeight="Bold" Foreground="#4B5563" Margin="4,2" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="Desc" FontWeight="Bold" Foreground="#4B5563" Margin="4,2" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="Tax"  FontWeight="Bold" Foreground="#4B5563" Margin="4,2" FontSize="12" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </controls:SmartComboBox.GroupStyle>
                    <controls:SmartComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding HsnCode}"
                           FontSize="14" Margin="4,2" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding ItemDescription}"
                           FontSize="13" Margin="4,2" Foreground="#6B7280"
                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding TaxRate, StringFormat='{}{0}%'}"
                           FontSize="14" Margin="4,2" Foreground="#D97706"
                           FontWeight="SemiBold" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </controls:SmartComboBox.ItemTemplate>
                </controls:SmartComboBox>
                <TextBlock x:Name="txtHSNDescription" Text="" Margin="15 0 0 0" Foreground="Gray"/>
            </StackPanel>

            <TextBlock Text="Item Name" Grid.Row="1" Grid.Column="0" />
            <TextBox x:Name="txtItemName" Grid.Row="1" Grid.Column="1" 
                     helpers:FocusBehavior.MoveOnEnter="True"/>

            <TextBlock Text="Item Category Name" Grid.Row="2" Grid.Column="0" />
            <controls:SmartComboBox x:Name="cmbCategoryName" Grid.Row="2" Grid.Column="1" 
                      DisplayMemberPath="CategoryName" SelectedValuePath="CategoryCode"
                      MoveOnEnter="True"/>

            <TextBlock Text="Company Name" Grid.Row="3" Grid.Column="0" />
            <controls:SmartComboBox x:Name="cmbCompanyName" Grid.Row="3" Grid.Column="1" 
                      DisplayMemberPath="CompanyName" SelectedValuePath="CompanyCode"
                      MoveOnEnter="True"/>

            <TextBlock Text="M.R.P" Grid.Row="4" Grid.Column="0" />
            <TextBox x:Name="txtMrp" Grid.Row="4" Grid.Column="1" 
                     helpers:TextBoxBehavior.SelectAllOnFocus="True" 
                     helpers:FocusBehavior.MoveOnEnter="True"
                     helpers:TextBoxBehavior.IsDecimal="True"/>

            <TextBlock Text="Unit Price (Sales)" Grid.Row="5" Grid.Column="0" />
            <TextBox x:Name="txtUnitPriceSales" Grid.Row="5" Grid.Column="1" 
                     helpers:TextBoxBehavior.SelectAllOnFocus="True" 
                     helpers:FocusBehavior.MoveOnEnter="True"
                     helpers:TextBoxBehavior.IsDecimal="True"/>

            <TextBlock Text="Unit Price (Purchase)" Grid.Row="6" Grid.Column="0" />
            <TextBox x:Name="txtUnitPricePurchase" Grid.Row="6" Grid.Column="1" 
                     helpers:TextBoxBehavior.SelectAllOnFocus="True" 
                     helpers:FocusBehavior.MoveOnEnter="True"
                     helpers:TextBoxBehavior.IsDecimal="True"/>

            <TextBlock Text="Tax Rate" Grid.Row="7" Grid.Column="0" />
            <TextBox x:Name="txtTaxRate" Grid.Row="7" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                     helpers:TextBoxBehavior.SelectAllOnFocus="True" 
                     helpers:FocusBehavior.MoveOnEnter="True"
                     helpers:TextBoxBehavior.IsDecimal="True"/>

            <TextBlock Text="Qty/Pouch" Grid.Row="8" Grid.Column="0" />
            <TextBox x:Name="txtQtyPouch" Grid.Row="8" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                     helpers:TextBoxBehavior.SelectAllOnFocus="True" 
                     helpers:FocusBehavior.MoveOnEnter="True"
                     helpers:TextBoxBehavior.IsDecimal="True"/>

            <TextBlock Text="Pouch/Box" Grid.Row="9" Grid.Column="0" />
            <TextBox x:Name="txtPouchBox" Grid.Row="9" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                     helpers:TextBoxBehavior.SelectAllOnFocus="True" 
                     helpers:FocusBehavior.MoveOnEnter="True"
                     helpers:TextBoxBehavior.IsDecimal="True"/>

            <!-- Opening Stock row removed: stock is now entered exclusively via
                 the Opening Stock Entry screen and lives in the ledger, never here. -->

            <TextBlock Text="Re Order Level" Grid.Row="10" Grid.Column="0" />
            <TextBox x:Name="txtReorderLevel" Grid.Row="10" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                     helpers:TextBoxBehavior.SelectAllOnFocus="True" 
                     helpers:FocusBehavior.MoveOnEnter="True"
                     helpers:TextBoxBehavior.IsDecimal="True"/>

            <TextBlock Text="Rack" Grid.Row="11" Grid.Column="0" />
            <TextBox x:Name="txtRackName" Grid.Row="11" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                     helpers:TextBoxBehavior.SelectAllOnFocus="True"
                     helpers:FocusBehavior.MoveOnEnter="True"/>

            <TextBlock Text="Sales Unit" Grid.Row="12" Grid.Column="0" />
            <controls:SmartComboBox x:Name="cmbUqc" Grid.Row="12" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                                    DisplayMemberPath="DisplayText" SelectedValuePath="UQC"
                                    MoveOnEnter="True"/>


            <TextBlock Text="Category" Grid.Row="13" Grid.Column="0" />
            <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="cmbCategory" Width="150" HorizontalAlignment="Left"
                    helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnSave}">
                    <ComboBoxItem Content="Finished Goods" />
                    <ComboBoxItem Content="Raw Material" />
                    <ComboBoxItem Content="Consumables" />
                    <ComboBoxItem Content="Non Stockable" />
                </ComboBox>

                <TextBlock Text="Is Active:" Margin="16 0" />
                <ComboBox x:Name="cmbIsActive" Width="100" HorizontalAlignment="Left"
                    helpers:FocusBehavior.TargetOnEnter="{Binding ElementName=btnSave}">
                    <ComboBoxItem Content="Yes"/>
                    <ComboBoxItem Content="No"/>
                </ComboBox>

            </StackPanel>

        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnNew"     Content="New"     Click="BtnNew_Click"/>
            <Button x:Name="btnDisplay" Content="Display" Click="BtnDisplay_Click"/>
            <Button x:Name="btnSave"    Content="Save"    Click="BtnSave_Click" Style="{StaticResource PrimaryOutlineButton}" IsEnabled="False"/>
            <Button x:Name="btnDelete"  Content="Delete"  Click="BtnDelete_Click" Style="{StaticResource DangerOutlineButton}" IsEnabled="False"/>
            <Button x:Name="btnClose"   Content="Close"   helpers:CloseTabBehavior.CloseOnClick="True" Margin="0"/>
        </StackPanel>
        <controls:GenericSearchOverlay x:Name="SearchOverlay" Grid.RowSpan="2" Panel.ZIndex="999" />
    </Grid>

</UserControl>
